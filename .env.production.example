# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO (ORACLE CLOUD / VPS COM DOCKER COMPOSE)
# ==============================================================================

# --- CONFIGURAÇÃO DO BOT (NODE.JS) ---
SERVER_TYPE=http
SERVER_PORT=8080
# Coloque seu IP público da Oracle ou domínio (ex: http://123.45.67.89:8080 ou https://bot.seudominio.com)
SERVER_URL=http://localhost:8080

# --- BANCO DE DADOS POSTGRESQL (Container interno) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TroquePorUmaSenhaForte123!
DB_NAME=evolution_db

# --- CONFIGURAÇÃO DA EVOLUTION API ---
# Comunicação interna rápida via rede Docker
EVOLUTION_URL=http://api:8080
EVOLUTION_INSTANCE_NAME=FavoDeMel
EVOLUTION_API_KEY=CRIE_UMA_CHAVE_SEGURA_AQUI_Exemplo32Chars99

# --- CREDENCIAIS DO PAINEL ADMIN ---
ADMIN_USER=admin
ADMIN_PASS=SenhaAdminForte123!

# --- CONFIGURAÇÕES DE NEGÓCIO E I.A. ---
NUMERO_DA_LOJA=557988125726
ETIQUETA_NOME=Favo de Mel
GEMINI_API_KEY=SuaChaveGoogleGeminiAqui

# ==============================================================================
# CONFIGURAÇÕES ESPECÍFICAS DA EVOLUTION API (OTIMIZADAS PARA PERFORMANCE)
# ==============================================================================
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:TroquePorUmaSenhaForte123!@postgres:5432/evolution_db?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Otimizações de Memória e Disco (desativa sync pesado de históricos antigos)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_MESSAGES=false

# Cache Redis (Aumenta velocidade e economiza consultas no banco)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Autenticação e Idioma da Evolution
AUTHENTICATION_API_KEY=CRIE_UMA_CHAVE_SEGURA_AQUI_Exemplo32Chars99
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=pt
QRCODE_LIMIT=30
QRCODE_COLOR='#175197'

# Webhook Automático (A Evolution fala direto com o Bot via Docker)
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://bot-favo-de-mel:8080/webhook/evolution
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
