                    <label class="block text-xs font-semibold text-slate-700 mb-1">Nome do Atendente *</label>
                    <input type="text" id="perfilNome" required placeholder="Ex: Favo de Mel ou seu nome"
                        value="<%= (typeof user !=='undefined' && user && user.name) ? user.name : 'Favo de Mel' %>"
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-amber-500/40">
                    <span class="text-[10px] text-slate-400 mt-0.5 block">Identificação interna usada no atendimento.</span>
