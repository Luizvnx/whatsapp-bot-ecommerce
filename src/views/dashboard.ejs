        function filtrarProdutosCatalogo() {
            const busca = (document.getElementById('buscaProdutoCatalogo')?.value || '').toLowerCase().trim();
            const catFiltro = document.getElementById('filtroCategoriaCatalogo')?.value;

            const filtrados = catalogoProdutosCache.filter(prod => {
                const matchTexto = !busca || 
                    (prod.nome && prod.nome.toLowerCase().includes(busca)) || 
                    (prod.descricao && prod.descricao.toLowerCase().includes(busca));
                const matchCat = !catFiltro || String(prod.categoria_id) === String(catFiltro);
                return matchTexto && matchCat;
            });

            renderizarProdutosCatalogo(filtrados);
        }

        // ==========================================
        // GERENCIAMENTO DE FOTO DO PRODUTO (PREVIEW E COMPRESSÃO)
        // ==========================================
        let fotoProdutoAtual = null;

        function aoSelecionarFotoProduto(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                mostrarToast('Por favor, selecione um arquivo de imagem válido (JPG, PNG, WEBP).', 'erro');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    // Redimensiona inteligentemente via canvas para otimizar velocidade e armazenamento
                    const MAX_SIZE = 1000;
                    let width = img.width;
                    let height = img.height;

                    if (width > MAX_SIZE || height > MAX_SIZE) {
                        if (width > height) {
                            height = Math.round((height * MAX_SIZE) / width);
                            width = MAX_SIZE;
                        } else {
                            width = Math.round((width * MAX_SIZE) / height);
                            height = MAX_SIZE;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
                    fotoProdutoAtual = compressedDataUrl;

                    const imgPreview = document.getElementById('prodEditFotoPreview');
                    const placeholder = document.getElementById('prodEditFotoPlaceholder');
                    const btnRemover = document.getElementById('btnRemoverFotoProduto');
                    const inputUrl = document.getElementById('prodEditFotoUrl');

                    if (imgPreview) {
                        imgPreview.src = compressedDataUrl;
                        imgPreview.classList.remove('hidden');
                    }
                    if (placeholder) placeholder.classList.add('hidden');
                    if (btnRemover) btnRemover.classList.remove('hidden');
                    if (inputUrl) inputUrl.value = '';
                };
                img.onerror = () => {
                    mostrarToast('Erro ao carregar a imagem selecionada.', 'erro');
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function aoDigitarUrlFotoProduto(url) {
            const urlLimpa = (url || '').trim();
            const imgPreview = document.getElementById('prodEditFotoPreview');
            const placeholder = document.getElementById('prodEditFotoPlaceholder');
            const btnRemover = document.getElementById('btnRemoverFotoProduto');

            if (!urlLimpa) {
                removerFotoProduto();
                return;
            }

            fotoProdutoAtual = urlLimpa;
            if (imgPreview) {
                imgPreview.src = urlLimpa;
                imgPreview.classList.remove('hidden');
            }
            if (placeholder) placeholder.classList.add('hidden');
            if (btnRemover) btnRemover.classList.remove('hidden');
        }

        function removerFotoProduto() {
            fotoProdutoAtual = null;
            const inputArquivo = document.getElementById('prodEditFotoArquivo');
            const inputUrl = document.getElementById('prodEditFotoUrl');
            const imgPreview = document.getElementById('prodEditFotoPreview');
            const placeholder = document.getElementById('prodEditFotoPlaceholder');
            const btnRemover = document.getElementById('btnRemoverFotoProduto');

            if (inputArquivo) inputArquivo.value = '';
            if (inputUrl) inputUrl.value = '';
            if (imgPreview) {
                imgPreview.src = '';
                imgPreview.classList.add('hidden');
            }
            if (placeholder) placeholder.classList.remove('hidden');
            if (btnRemover) btnRemover.classList.add('hidden');
        }

