                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Participantes (Números com DDD) <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="inputGrupoParticipantes"
                        placeholder="Digite os números separados por vírgula ou em linhas separadas.&#10;Ex:&#10;79991054091&#10;79981159556"
                        rows="3" required
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition font-mono custom-scrollbar"></textarea>
                    <p class="text-[10px] text-slate-400 mt-1">Ao menos um participante deve ser informado.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Descrição do Grupo (Opcional)
                    </label>
                    <input type="text" id="inputGrupoDescricao" placeholder="Breve descrição dos objetivos do grupo..."
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Primeira Mensagem do Grupo (Opcional)
                    </label>
                    <textarea id="inputGrupoMensagemInicial" placeholder="Ex: Sejam todos bem-vindos ao grupo!" rows="2"
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition resize-none custom-scrollbar"></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-2 border-t border-slate-100">
                    <button type="button" onclick="fecharModalNovaConversa()"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition">Cancelar</button>
                    <button type="submit" id="btnSubmitNovoGrupo"
                        class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1.5">
                        <span>👥</span>
                        <span>Criar Grupo no WhatsApp</span>
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
        let conversaAtivaId = null;
        let conversaAtivaDados = null;
        let termoBusca = '';
        let timeoutBusca = null;
        let estaCarregandoConversas = false;

        // Estado do Gravador de Áudio
        let mediaRecorder = null;
        let audioChunks = [];
        let timerGravacaoInterval = null;
        let segundosGravacao = 0;

        // Estado do Modal de Anexo
        let anexoSelecionado = null; // { file, base64, mediatype, mimetype, fileName }

        // Estado de Resposta / Citação de Mensagem (Reply)
        let mensagemRespondendo = null; // { id, whatsappMessageId, texto, autor, remetente, tipo }

        // Estado de Exclusão de Mensagem (Apagar para todos)
        let mensagemParaApagar = null; // { id_cliente, id_mensagem, whatsappMessageId }

        // ==========================================
        // 1. ÁUDIO & NOTIFICAÇÕES NATIVAS (Web Audio API)
        // ==========================================
        let audioCtx = null;
        let somAtivo = localStorage.getItem('vip_som_ativo') !== 'false';

        function inicializarAudioContext() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (AudioContextClass) {
                    audioCtx = new AudioContextClass();
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function tocarSomNotificacao() {
            if (!somAtivo) return;
            try {
                inicializarAudioContext();
                if (!audioCtx) return;

                const agora = audioCtx.currentTime;
                const osc1 = audioCtx.createOscillator();
                const gain1 = audioCtx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(587.33, agora);
                gain1.gain.setValueAtTime(0, agora);
                gain1.gain.linearRampToValueAtTime(0.18, agora + 0.02);
                gain1.gain.exponentialRampToValueAtTime(0.001, agora + 0.35);
                osc1.connect(gain1);
                gain1.connect(audioCtx.destination);
                osc1.start(agora);
                osc1.stop(agora + 0.35);

                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(880.00, agora + 0.08);
                gain2.gain.setValueAtTime(0, agora + 0.08);
                gain2.gain.linearRampToValueAtTime(0.22, agora + 0.10);
                gain2.gain.exponentialRampToValueAtTime(0.001, agora + 0.50);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start(agora + 0.08);
                osc2.stop(agora + 0.50);
            } catch (e) {
                console.warn('Alerta sonoro:', e);
            }
        }

        function alternarSom() {
            inicializarAudioContext();
            somAtivo = !somAtivo;
            localStorage.setItem('vip_som_ativo', somAtivo);
            atualizarIconeSom();
            mostrarToast(somAtivo ? 'Alerta sonoro ativado (🔊)' : 'Alerta sonoro silenciado (🔇)', somAtivo ? 'sucesso' : 'info');
            if (somAtivo) tocarSomNotificacao();
        }

        function atualizarIconeSom() {
            const btn = document.getElementById('btnToggleSom');
            const icon = document.getElementById('iconSom');
            if (btn && icon) {
                if (somAtivo) {
                    icon.textContent = '🔊';
                    btn.title = 'Alerta Sonoro Ativo (Clique para silenciar)';
                    btn.classList.add('text-emerald-400');
                } else {
                    icon.textContent = '🔇';
                    btn.title = 'Alerta Sonoro Silenciado (Clique para ativar)';
                    btn.classList.remove('text-emerald-400');
                }
            }
        }

        async function solicitarOuTestarNotificacao() {
            if (!("Notification" in window)) {
                mostrarToast('Seu navegador não suporta notificações nativas.', 'erro');
                return;
            }

            if (Notification.permission === 'granted') {
                dispararNotificacaoNavegador('Favo de Mel', 'Notificações de atendimento ativas e funcionando!');
                mostrarToast('Notificações no navegador já estão ativas!', 'sucesso');
            } else if (Notification.permission !== 'denied') {
                const permission = await Notification.requestPermission();
                if (permission === 'granted') {
                    atualizarIconeNotificacao();
                    dispararNotificacaoNavegador('Favo de Mel', 'Notificações ativadas com sucesso!');
                    mostrarToast('Notificações ativadas com sucesso!', 'sucesso');
                } else {
                    atualizarIconeNotificacao();
                    mostrarToast('Permissão de notificação negada.', 'erro');
                }
            } else {
                mostrarToast('Notificações bloqueadas nas permissões do site.', 'erro');
            }
        }

        function dispararNotificacaoNavegador(titulo, corpo, idCliente = null) {
            if (!("Notification" in window) || Notification.permission !== 'granted') return;

            try {
                const notif = new Notification(titulo, {
                    body: corpo,
                    icon: '/favicon-32x32.png',
                    badge: '/favicon-16x16.png',
                    tag: idCliente || 'favodemel-whatsapp',
                    renotify: true
                });

                notif.onclick = () => {
                    window.focus();
                    if (idCliente) {
                        selecionarConversa(idCliente);
                    }
                    notif.close();
                };
            } catch (e) {
                console.warn('Erro ao disparar notificação nativa:', e);
            }
        }

        function atualizarIconeNotificacao() {
            const btn = document.getElementById('btnToggleNotif');
            const icon = document.getElementById('iconNotif');
            if (btn && icon) {
                if ("Notification" in window && Notification.permission === 'granted') {
                    icon.textContent = '🔔';
                    btn.title = 'Notificações do Navegador Ativas';
                    btn.classList.add('text-emerald-400');
                } else {
                    icon.textContent = '🔕';
                    btn.title = 'Clique para ativar notificações no Navegador';
                    btn.classList.remove('text-emerald-400');
                }
            }
        }

        // ==========================================
        // 2. SOCKET.IO (TEMPO REAL & WEBSOCKET)
        // ==========================================
        const socket = io();

        socket.on('connect', () => {
            console.log('⚡ [Socket.io] Conectado ao servidor de eventos em tempo real.');
            const badge = document.getElementById('badgeSocket');
            if (badge) {
                badge.className = 'hidden sm:flex items-center gap-1.5 text-[11px] font-semibold bg-emerald-500/10 px-2.5 py-1 rounded-xl border border-emerald-500/20 text-emerald-400';
                badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span>Tempo Real</span>';
            }
        });

        socket.on('disconnect', () => {
            console.warn('⚠️ [Socket.io] Conexão em tempo real desconectada.');
            const badge = document.getElementById('badgeSocket');
            if (badge) {
                badge.className = 'hidden sm:flex items-center gap-1.5 text-[11px] font-semibold bg-amber-500/10 px-2.5 py-1 rounded-xl border border-amber-500/20 text-amber-400';
                badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>Reconectando...</span>';
            }
        });

        socket.on('nova_mensagem', (data) => {
            const { idCliente, nomeContato, mensagem } = data;
            const isAtendente = mensagem.remetente === 'atendente';

            const ehConversaAtiva = conversaAtivaId && (
                conversaAtivaId === idCliente ||
                conversaAtivaId.split('@')[0] === idCliente.split('@')[0]
            );

            if (ehConversaAtiva) {
                if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                    if (!conversaAtivaDados.historicoMensagens.some(m => m.id === mensagem.id)) {
                        conversaAtivaDados.historicoMensagens.push(mensagem);
                    }
                }

                const stream = document.getElementById('chatMensagensStream');

                const msgId = mensagem.id ? `msg-${mensagem.id}` : null;
                if (!msgId || !document.getElementById(msgId)) {
                    const hora = formatarData(mensagem.timestamp);
                    const div = document.createElement('div');
                    if (msgId) div.id = msgId;
                    if (mensagem.id) div.setAttribute('data-msg-id', mensagem.id);
                    if (mensagem.whatsappMessageId) div.setAttribute('data-whatsapp-id', mensagem.whatsappMessageId);
                    div.className = isAtendente ? 'flex flex-col items-end animate-fadeIn w-full' : 'flex flex-col items-start animate-fadeIn w-full';

                    div.innerHTML = renderizarBolhaMensagem(mensagem, isAtendente, nomeContato, hora);

                    if (stream.children.length === 1 && stream.children[0].textContent.includes('Nenhuma mensagem')) {
                        stream.innerHTML = '';
                    }

                    stream.appendChild(div);
                    stream.scrollTop = stream.scrollHeight;
                }
            }

            if (!isAtendente) {
                tocarSomNotificacao();

                if (document.hidden || !ehConversaAtiva) {
                    dispararNotificacaoNavegador(nomeContato || 'Mensagem do Cliente', mensagem.texto, idCliente);
                }

                if (!ehConversaAtiva) {
                    mostrarToast(`💬 ${nomeContato || 'Cliente'}: ${mensagem.texto.substring(0, 35)}...`, 'info');
                }
            }

            carregarListaConversas();
        });

        socket.on('status_instancia', (data) => {
            if (data?.status) {
                const badge = document.getElementById('badgeStatus');
                const alerta = document.getElementById('alertaConexao');
                if (data.status === 'open') {
                    badge.className = 'flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-semibold bg-emerald-500/10 text-emerald-400 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl border border-emerald-500/20 shadow-sm';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span class="hidden sm:inline">WhatsApp Conectado</span><span class="sm:hidden">Conectado</span>';
                    if (alerta) alerta.classList.add('hidden');
                } else if (data.status === 'qrcode' || data.status === 'close') {
                    badge.className = 'flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-semibold bg-rose-950 text-rose-300 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl border border-rose-800 shadow-sm animate-pulse';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="hidden sm:inline">WhatsApp Desconectado</span><span class="sm:hidden">Desconectado</span>';
                    if (alerta) alerta.classList.remove('hidden');
                }
            }
        });

        socket.on('modo_alterado', (data) => {
            if (conversaAtivaId === data.idCliente) {
                atualizarBadgeModo(data.modo);
            }
        });

        socket.on('mensagem_apagada', (data) => {
            if (!data || !data.idMensagem) return;
            const ehConversaAtiva = conversaAtivaId && data.idCliente && (
                conversaAtivaId === data.idCliente ||
                conversaAtivaId.split('@')[0] === data.idCliente.split('@')[0] ||
                (data.numeroLimpo && conversaAtivaId.split('@')[0] === data.numeroLimpo)
            );

            if (ehConversaAtiva && conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                const msg = conversaAtivaDados.historicoMensagens.find(m => 
                    m.id === data.idMensagem || 
                    m.whatsappMessageId === data.idMensagem ||
                    (data.whatsappMessageId && (m.id === data.whatsappMessageId || m.whatsappMessageId === data.whatsappMessageId))
                );
                if (msg) {
                    msg.apagada = true;
                    msg.apagadaPor = data.apagadaPor || 'cliente';
                    msg.apagadaEm = data.apagadaEm || new Date().toISOString();
                }
                atualizarBolhaMensagemApagada(data.idMensagem, data.apagadaPor);
            }
            carregarListaConversas();
        });

        // ==========================================
        // 3. RENDERIZAÇÃO DE BOLHAS DE MENSAGENS (TEXTO, ÁUDIO, MÍDIAS)
        // ==========================================
        function formatarTextoMarkdown(texto) {
            if (!texto) return '';
            const esc = texto.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            return esc.replace(/\*(.*?)\*/g, '<strong class="font-bold">$1</strong>');
        }

        function renderizarBolhaMensagem(msg, isAtendente, nomeContato, hora) {
            const isApagada = msg.apagada === true;
            const tipo = msg.tipo || 'texto';
            const autor = isAtendente ? (msg.atendenteNome ? `Atendente (${msg.atendenteNome})` : 'Atendente') : (nomeContato || 'Cliente');
            const bgClass = isAtendente ? 'bg-[#d9fdd3] text-slate-900 rounded-2xl rounded-tr-xs border border-[#c1f5b8] shadow-xs' : 'bg-white text-slate-900 rounded-2xl rounded-tl-xs border border-slate-200/80 shadow-xs';
            const autorColor = isAtendente ? 'text-emerald-800 font-bold' : 'text-slate-600 font-bold';
            const horaColor = isAtendente ? 'text-slate-500' : 'text-slate-400';

            let conteudoCorpo = '';

            function resolverSrcMidia(mediaBase64, mediaUrl, mimePadrao) {
                let src = mediaBase64;
                if (!src && mediaUrl && !mediaUrl.includes('whatsapp.net')) {
                    src = mediaUrl;
                }
                if (src && !src.startsWith('data:') && !src.startsWith('http://') && !src.startsWith('https://')) {
                    src = `data:${mimePadrao};base64,${src}`;
                }
                return src || null;
            }

            if (tipo === 'audio' || msg.mediaUrl?.endsWith('.mp3') || msg.mediaUrl?.endsWith('.ogg')) {
                const srcAudio = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'audio/ogg');
                conteudoCorpo = `
                    <div class="space-y-1.5 min-w-[210px] sm:min-w-[240px]">
                        <div class="flex items-center gap-2 text-[11px] font-semibold text-slate-700">
                            <span>🎙️ Mensagem de Voz</span>
                        </div>
                        ${srcAudio ? `<audio controls class="w-full h-8 rounded-lg outline-none" src="${srcAudio}"></audio>` : `<p class="text-xs text-slate-400 italic">🎙️ [Áudio recebido]</p>`}
                        ${msg.texto && !msg.texto.includes('[🎙️ Mensagem de Voz]') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed mt-1 text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'figurinha' || msg.texto === '[🎨 Figurinha]') {
                const srcSticker = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'image/webp');
                conteudoCorpo = `
                    <div class="space-y-1">
                        ${srcSticker ? `<img src="${srcSticker}" onclick="abrirModalZoom(this.src)" class="max-w-[120px] max-h-32 object-contain cursor-pointer hover:opacity-90 transition">` : `<p class="text-xs font-semibold text-slate-700">🎨 [Figurinha]</p>`}
                    </div>
                `;
            } else if (tipo === 'video' || msg.mediaUrl?.match(/\.(mp4|webm|mkv|avi|mov)/i)) {
                const srcVideo = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'video/mp4');
                conteudoCorpo = `
                    <div class="space-y-1.5 max-w-xs">
                        ${srcVideo ? `<video controls class="rounded-xl w-full max-h-60 object-cover border border-slate-200 shadow-xs" src="${srcVideo}"></video>` : `<p class="text-xs text-slate-400 italic">🎥 [Vídeo recebido]</p>`}
                        ${msg.texto && msg.texto !== '[🎥 Vídeo]' && msg.texto !== '[🎥 Vídeo enviado]' ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'imagem' || msg.mediaUrl?.match(/\.(jpeg|jpg|gif|png|webp)/i)) {
                const srcImg = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'image/jpeg');
                conteudoCorpo = `
                    <div class="space-y-1.5">
                        ${srcImg ? `<img src="${srcImg}" onclick="abrirModalZoom(this.src)" 
                             class="rounded-xl max-w-xs max-h-60 object-cover cursor-pointer hover:opacity-90 transition border border-slate-200 shadow-xs">` : `<p class="text-xs text-slate-400 italic">🖼️ [Imagem recebida]</p>`}
                        ${msg.texto && msg.texto !== '[🖼️ Imagem]' && msg.texto !== '[🖼️ Imagem enviada]' ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'documento') {
                const srcDoc = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'application/pdf');
                conteudoCorpo = `
                    <div class="space-y-1.5 min-w-[200px]">
                        <div class="flex items-center gap-2.5 p-2 bg-slate-50 rounded-xl border border-slate-200">
                            <span class="text-2xl">📄</span>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-bold text-slate-800 truncate">${msg.fileName || 'documento.pdf'}</p>
                                <span class="text-[10px] text-slate-500">Documento / Anexo</span>
                            </div>
                            ${srcDoc ? `<a href="${srcDoc}" download="${msg.fileName || 'documento'}" class="p-1.5 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 rounded-lg text-xs font-semibold" title="Baixar">⬇️</a>` : '<span class="text-[10px] text-slate-400 italic">Anexo</span>'}
                        </div>
                        ${msg.texto && !msg.texto.startsWith('[📄') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else {
                conteudoCorpo = `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>`;
            }

            if (isApagada) {
                const quemApagou = msg.apagadaPor === 'atendente' ? 'pelo atendente' : 'pelo cliente';
                conteudoCorpo = `
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-1.5 text-xs italic ${isAtendente ? 'text-emerald-700' : 'text-slate-500'} py-0.5 select-none">
                            <svg class="w-3.5 h-3.5 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                            </svg>
                            <span class="font-medium tracking-wide">Mensagem apagada</span>
                            <span class="text-[10px] opacity-60 font-normal">(${quemApagou})</span>
