        // ==========================================
        // 7. FUNÇÕES DE UI E FORMATAÇÃO
        // ==========================================
        function formatarData(isoString) {
            if (!isoString) return '';
            const data = new Date(isoString);
            const agora = new Date();
            const diffMinutos = Math.floor((agora - data) / (1000 * 60));

            if (diffMinutos < 1) return 'Agora';
            if (diffMinutos < 60) return `${diffMinutos}m`;

            const hoje = data.toDateString() === agora.toDateString();
            if (hoje) {
                return data.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
            }
            return data.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
        }

        function mostrarToast(mensagem, tipo = 'sucesso') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');

            const dotCor = tipo === 'sucesso' ? 'bg-emerald-600' : tipo === 'erro' ? 'bg-rose-600' : 'bg-stone-700';

            toast.className = 'border border-stone-300 bg-white text-stone-900 px-3 py-2 rounded-sm shadow-md flex items-center gap-2 text-xs font-mono font-medium transition-all transform duration-200 pointer-events-auto max-w-sm translate-y-2 opacity-0';
            toast.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${dotCor} flex-shrink-0"></span><span>${mensagem}</span>`;

            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 250);
            }, 3500);
        }

        // ==========================================
        // 8. CARREGAMENTO E ATENDIMENTO DE CONVERSAS
        // ==========================================
        async function carregarListaConversas() {
            if (estaCarregandoConversas) return;
            estaCarregandoConversas = true;

            try {
                const params = new URLSearchParams();
                if (termoBusca) params.append('busca', termoBusca);

                const res = await fetch(`/admin/conversas?${params.toString()}`);
                const result = await res.json();

                if (result.success) {
                    const container = document.getElementById('listaConversas');
                    document.getElementById('badgeTotalConversas').textContent = result.data.length;

                    if (result.data.length === 0) {
                        container.innerHTML = `
                            <div class="p-8 text-center text-slate-500 text-xs">
                                Nenhuma conversa encontrada.
                            </div>
                        `;
                        return;
                    }

                    container.innerHTML = '';
                    result.data.forEach(item => {
                        const isSelected = conversaAtivaId === item.id_cliente;
                        const div = document.createElement('div');
                        div.className = `p-3 flex items-center gap-3 cursor-pointer transition border-l-2 ${isSelected ? 'bg-amber-50/90 border-amber-500 text-slate-900' : 'hover:bg-slate-50 border-transparent text-slate-800'}`;
                        div.onclick = () => selecionarConversa(item.id_cliente);

                        div.innerHTML = `
                            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-sm flex-shrink-0 border border-slate-200">
                                ${(item.nome_contato || 'C').charAt(0).toUpperCase()}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-baseline mb-1">
                                    <h4 class="text-xs font-bold text-slate-900 truncate">${item.nome_contato}</h4>
                                    <span class="text-[10px] text-slate-400 font-medium">${formatarData(item.ultima_msg)}</span>
                                </div>
                                <p class="text-xs text-slate-500 truncate">${item.preview || 'Sem mensagens'}</p>
                            </div>
                        `;
                        container.appendChild(div);
                    });
                }
            } catch (err) {
                console.error('Erro ao carregar lista de conversas:', err);
            } finally {
                estaCarregandoConversas = false;
            }
        }

        function aoDigitarBusca() {
            clearTimeout(timeoutBusca);
            timeoutBusca = setTimeout(() => {
                termoBusca = document.getElementById('campoBusca').value.trim();
                carregarListaConversas();
            }, 300);
        }

        async function selecionarConversa(idCliente) {
            window.scrollTo(0, 0);
            if (document.body) document.body.scrollTop = 0;
            if (document.documentElement) document.documentElement.scrollTop = 0;
            cancelarResposta();
            conversaAtivaId = idCliente;

            document.getElementById('chatEmptyState').classList.add('hidden');
            document.getElementById('chatContent').classList.remove('hidden');

            const painelLista = document.getElementById('painelLista');
            const painelChat = document.getElementById('painelChat');

            if (window.innerWidth < 768) {
                if (painelLista) {
                    painelLista.classList.add('hidden');
                    painelLista.classList.remove('flex');
                }
                if (painelChat) {
                    painelChat.classList.remove('hidden');
                    painelChat.classList.add('flex');
                }
            } else {
                if (painelLista) {
                    painelLista.classList.remove('hidden');
                    painelLista.classList.add('flex');
                }
                if (painelChat) {
                    painelChat.classList.remove('hidden');
                    painelChat.classList.add('flex');
                }
            }

            carregarListaConversas();
            carregarMensagensConversaAtiva();
        }

        function voltarParaLista() {
            cancelarResposta();
            conversaAtivaId = null;
            conversaAtivaDados = null;
            atualizarBadgeCarrinhoCliente([]);

            const painelLista = document.getElementById('painelLista');
            const painelChat = document.getElementById('painelChat');

            if (window.innerWidth < 768) {
                if (painelLista) {
                    painelLista.classList.remove('hidden');
                    painelLista.classList.add('flex');
                }
                if (painelChat) {
                    painelChat.classList.add('hidden');
                    painelChat.classList.remove('flex');
                }
            } else {
                if (painelLista) {
                    painelLista.classList.remove('hidden');
                    painelLista.classList.add('flex');
                }
                if (painelChat) {
                    painelChat.classList.remove('hidden');
                    painelChat.classList.add('flex');
                }
            }

            document.getElementById('chatEmptyState').classList.remove('hidden');
            document.getElementById('chatContent').classList.add('hidden');

            carregarListaConversas();
        }

        window.addEventListener('resize', () => {
            const painelLista = document.getElementById('painelLista');
            const painelChat = document.getElementById('painelChat');
            if (!painelLista || !painelChat) return;

            if (window.innerWidth >= 768) {
                painelLista.classList.remove('hidden');
                painelLista.classList.add('flex');
                painelChat.classList.remove('hidden');
                painelChat.classList.add('flex');
            } else {
                if (conversaAtivaId) {
                    painelLista.classList.add('hidden');
                    painelLista.classList.remove('flex');
                    painelChat.classList.remove('hidden');
                    painelChat.classList.add('flex');
                } else {
                    painelLista.classList.remove('hidden');
                    painelLista.classList.add('flex');
                    painelChat.classList.add('hidden');
                    painelChat.classList.remove('flex');
                }
            }
        });

        async function carregarMensagensConversaAtiva() {
            if (!conversaAtivaId) return;

            try {
                const res = await fetch(`/admin/conversa/${encodeURIComponent(conversaAtivaId)}`);
                const result = await res.json();

                if (result.success && result.data) {
                    conversaAtivaDados = result.data;
                    const conversa = result.data;
                    const numeroLimpo = conversa.id_cliente.split('@')[0];

                    document.getElementById('chatHeaderNome').textContent = conversa.nome_contato || 'Cliente';
                    document.getElementById('chatHeaderNumero').textContent = numeroLimpo;
                    document.getElementById('chatHeaderAvatar').textContent = (conversa.nome_contato || 'C').charAt(0).toUpperCase();
                    document.getElementById('btnAbrirWhatsappDirect').href = `https://wa.me/${numeroLimpo}`;

                    atualizarBadgeModo(conversa.modo_atendimento || 'copiloto');
                    atualizarBadgeCarrinhoCliente(conversa.carrinho);

                    const stream = document.getElementById('chatMensagensStream');
                    const mensagens = conversa.historicoMensagens || [];

                    const noFim = (stream.scrollHeight - stream.scrollTop - stream.clientHeight) < 60;

                    if (mensagens.length === 0) {
                        stream.innerHTML = `
                            <div class="text-center py-12 text-slate-500 text-xs italic">
                                Nenhuma mensagem neste histórico.
                            </div>
                        `;
                    } else {
                        stream.innerHTML = mensagens.map(msg => {
                            const isAtendente = msg.remetente === 'atendente';
                            const hora = formatarData(msg.timestamp);
                            const msgId = msg.id ? `id="msg-${msg.id}" data-msg-id="${msg.id}" data-whatsapp-id="${msg.whatsappMessageId || ''}"` : '';
                            const divClass = isAtendente ? 'flex flex-col items-end' : 'flex flex-col items-start';

                            return `
                                <div ${msgId} class="${divClass} w-full">
                                    ${renderizarBolhaMensagem(msg, isAtendente, conversa.nome_contato, hora)}
                                </div>
                            `;
                        }).join('');
                    }

                    if (noFim || stream.children.length <= 5) {
                        stream.scrollTop = stream.scrollHeight;
                    }
                }
            } catch (err) {
                console.error('Erro ao carregar mensagens da conversa ativa:', err);
            }
        }

        // ==========================================
        // 9. ENVIO DE MENSAGEM PELO PAINEL (TEXTAREA MULTILINHA)
        // ==========================================
        function autoAjustarAlturaTextarea(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 128) + 'px';
        }

        function aoPressionarTeclaMensagem(event) {
            if (event.key === 'Escape') {
                if (mensagemRespondendo) {
                    event.preventDefault();
                    cancelarResposta();
                }
                return;
            }

            if (event.key === 'Enter') {
                if (event.ctrlKey || event.shiftKey) {
                    // Ctrl + Enter ou Shift + Enter -> Quebra de linha (vai para a linha de baixo)
                    event.preventDefault();
                    const input = event.target;
                    const start = input.selectionStart;
                    const end = input.selectionEnd;
                    input.value = input.value.substring(0, start) + '\n' + input.value.substring(end);
                    input.selectionStart = input.selectionEnd = start + 1;
                    autoAjustarAlturaTextarea(input);
                } else {
                    // Enter sozinho -> Envia a mensagem
                    event.preventDefault();
                    enviarMensagem(event);
                }
            }
        }

        async function enviarMensagem(event) {
            if (event) event.preventDefault();
            if (!conversaAtivaId) return;

            const input = document.getElementById('inputMensagemChat');
            const mensagem = input.value.trim();
            if (!mensagem) return;

            const quotedParaEnviar = mensagemRespondendo ? { ...mensagemRespondendo } : null;
            cancelarResposta();

            input.value = '';
            autoAjustarAlturaTextarea(input);
            input.focus();

            try {
                const res = await fetch('/admin/enviar-mensagem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id_cliente: conversaAtivaId,
                        mensagem: mensagem,
                        quoted: quotedParaEnviar
                    })
                });

                const result = await res.json();
                if (!result.success) {
                    mostrarToast(result.message || 'Erro ao enviar mensagem', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o servidor.', 'erro');
            }
        }

        // ==========================================
        // 10. MONITORAMENTO DA EVOLUTION API & QR CODE
        // ==========================================
        let ultimoQrCodeBase64 = null;
        let modalQrCodeAberto = false;
        let intervaloPollingQrModal = null;

        function formatarSrcQrCode(raw) {
            if (!raw) return '';
            return raw.startsWith('data:image') ? raw : `data:image/png;base64,${raw}`;
        }

        async function monitorarInstancia() {
            try {
                const res = await fetch('/admin/instance-status');
                const result = await res.json();

                const badge = document.getElementById('badgeStatus');
                const alerta = document.getElementById('alertaConexao');
                const cardQr = document.getElementById('cardInstanciaQrCode');
                const cardBadge = document.getElementById('cardInstanciaStatusBadge');

                if (result.success) {
                    if (result.status === 'open') {
                        if (badge) {
                            badge.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-[#25D366] text-white shadow-xs hover:bg-[#20bd5a] transition cursor-pointer flex-shrink-0';
                            badge.title = 'WhatsApp Conectado e Operando';
                            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-white flex-shrink-0"></span><span>WhatsApp Conectado</span>';
                        }
                        if (alerta) alerta.classList.add('hidden');

                        if (cardBadge) {
                            cardBadge.className = 'text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30';
                            cardBadge.textContent = 'Conectado (Online)';
                        }
                        if (cardQr) {
                            cardQr.innerHTML = '<span class="text-stone-700 font-mono text-xs">Conexão ativa e sincronizada.</span>';
                        }

                        // Se o modal estava aberto aguardando conexão, comemora e fecha
                        if (modalQrCodeAberto) {
                            document.getElementById('qrCodeModalLoading')?.classList.add('hidden');
                            document.getElementById('qrCodeModalImagemContainer')?.classList.add('hidden');
                            document.getElementById('qrCodeModalConectado')?.classList.remove('hidden');
                            mostrarToast('WhatsApp conectado com sucesso.', 'sucesso');
                            setTimeout(() => fecharModalQrCode(), 2000);
                        }
                    } else if (result.status === 'qrcode' || result.status === 'connecting' || result.status === 'close') {
                        if (badge) {
                            badge.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-rose-600 text-white shadow-xs hover:bg-rose-700 transition cursor-pointer flex-shrink-0';
                            badge.title = 'WhatsApp Desconectado! Clique para ler o QR Code';
                            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-white flex-shrink-0"></span><span>WhatsApp Desconectado</span>';
                        }
                        if (alerta) alerta.classList.remove('hidden');

                        if (cardBadge) {
                            cardBadge.className = 'text-xs px-2.5 py-0.5 rounded-full font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30';
                            cardBadge.textContent = 'Aguardando QR Code';
                        }

                        if (result.qrCodeBase64) {
                            ultimoQrCodeBase64 = result.qrCodeBase64;
                            const srcImg = formatarSrcQrCode(result.qrCodeBase64);

                            // Atualiza imagem no modal
                            const modalImg = document.getElementById('qrCodeModalImg');
                            if (modalImg) modalImg.src = srcImg;
                            document.getElementById('qrCodeModalLoading')?.classList.add('hidden');
                            document.getElementById('qrCodeModalImagemContainer')?.classList.remove('hidden');
                            document.getElementById('qrCodeModalConectado')?.classList.add('hidden');

                            // Atualiza no card da aba Métricas
                            if (cardQr) {
                                cardQr.innerHTML = `
                                    <div class="flex flex-col items-center gap-2 p-2">
                                        <div class="p-2 bg-white rounded-sm shadow-md border border-slate-200">
                                            <img src="${srcImg}" alt="QR Code WhatsApp" class="w-48 h-48 object-contain">
                                        </div>
                                        <button type="button" onclick="abrirModalQrCode()" class="mt-1 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-sm text-xs font-bold transition shadow-sm">
                                            Abrir em Tela Maior
                                        </button>
                                    </div>
                                `;
                            }
                        }
                    } else {
                        if (badge) {
                            badge.className = 'flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-semibold bg-amber-50 text-amber-800 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-sm border border-amber-200 shadow-sm';
                            badge.innerHTML = `<span class="w-2 h-2 rounded-sm bg-stone-1000"></span><span>Status: ${result.status}</span>`;
                        }
                    }
                } else {
                    if (badge) {
                        badge.className = 'flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-semibold bg-slate-100 text-slate-600 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-sm border border-slate-200 shadow-sm';
                        badge.innerHTML = '<span class="w-2 h-2 rounded-sm bg-stone-1000"></span><span>Evolution Offline</span>';
                    }
                }
            } catch (err) {
                console.error('Erro ao consultar status da instância:', err);
            }
        }

        function abrirModalQrCode() {
            modalQrCodeAberto = true;
            document.getElementById('modalQrCodeWhatsApp').classList.remove('hidden');

            if (ultimoQrCodeBase64) {
                const srcImg = formatarSrcQrCode(ultimoQrCodeBase64);
                const modalImg = document.getElementById('qrCodeModalImg');
                if (modalImg) modalImg.src = srcImg;
                document.getElementById('qrCodeModalLoading')?.classList.add('hidden');
                document.getElementById('qrCodeModalImagemContainer')?.classList.remove('hidden');
                document.getElementById('qrCodeModalConectado')?.classList.add('hidden');
            } else {
                document.getElementById('qrCodeModalLoading')?.classList.remove('hidden');
                document.getElementById('qrCodeModalImagemContainer')?.classList.add('hidden');
                document.getElementById('qrCodeModalConectado')?.classList.add('hidden');
            }

            monitorarInstancia();

            // Auto-refresh a cada 5s enquanto o modal estiver aberto para checar conexão
            if (intervaloPollingQrModal) clearInterval(intervaloPollingQrModal);
            intervaloPollingQrModal = setInterval(monitorarInstancia, 5000);
        }

        function fecharModalQrCode() {
            modalQrCodeAberto = false;
            if (intervaloPollingQrModal) {
                clearInterval(intervaloPollingQrModal);
                intervaloPollingQrModal = null;
            }
            document.getElementById('modalQrCodeWhatsApp').classList.add('hidden');
        }

        async function carregarQrCodeModal(animar = false) {
            const btn = document.getElementById('btnAtualizarQrModal');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span><span>Atualizando...</span>';
            }
            document.getElementById('qrCodeModalLoading')?.classList.remove('hidden');
            document.getElementById('qrCodeModalImagemContainer')?.classList.add('hidden');

            await monitorarInstancia();

            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Atualizar QR Code</span>';
            }
        }

        function clicarBadgeStatus() {
            const badge = document.getElementById('badgeStatus');
            if (badge && (badge.textContent.includes('Desconectado') || badge.textContent.includes('Ler QR') || badge.textContent.includes('Offline'))) {
                abrirModalQrCode();
            }
        }

        function atualizarTudo(animarIcone = false) {
            if (animarIcone) {
                const icone = document.getElementById('iconRefresh');
                icone.classList.add('animate-spin');
                setTimeout(() => icone.classList.remove('animate-spin'), 800);
            }
            carregarListaConversas();
            if (conversaAtivaId) carregarMensagensConversaAtiva();
            monitorarInstancia();
            carregarStatusBotGlobal();
            carregarCategoriasSelect();
        }

        // ==========================================
        // 12. NOVA CONVERSA, NOVO CONTATO & NOVO GRUPO (ESTILO WHATSAPP)
        // ==========================================
        let abaNovaConversaAtiva = 'numero';
        let debounceVerificacaoNumero = null;

        function abrirModalNovaConversa() {
            document.getElementById('modalNovaConversa').classList.remove('hidden');
            trocarAbaNovaConversa('numero');
            setTimeout(() => {
                const el = document.getElementById('inputChatNumero');
                if (el) el.focus();
            }, 100);
        }

        function fecharModalNovaConversa() {
            document.getElementById('modalNovaConversa').classList.add('hidden');
            document.getElementById('formNovoChatNumero').reset();
            document.getElementById('formNovoContato').reset();
            document.getElementById('formNovoGrupo').reset();
            limparBadgeVerificacao('chat');
            limparBadgeVerificacao('contato');

            // Restaura seletores de país para o Brasil padrão
            const selChat = document.getElementById('selectPaisChat');
            if (selChat) { selChat.value = '55'; aoMudarPais('chat'); }
            const selContato = document.getElementById('selectPaisContato');
            if (selContato) { selContato.value = '55'; aoMudarPais('contato'); }
        }

        function trocarAbaNovaConversa(aba) {
            abaNovaConversaAtiva = aba;
            const tabBtnNumero = document.getElementById('tabBtnNumero');
            const tabBtnContato = document.getElementById('tabBtnContato');
            const tabBtnGrupo = document.getElementById('tabBtnGrupo');

            const formNumero = document.getElementById('formNovoChatNumero');
            const formContato = document.getElementById('formNovoContato');
            const formGrupo = document.getElementById('formNovoGrupo');

            const classesAtiva = 'tab-btn-nova-conversa flex-1 py-1.5 px-3 text-xs font-semibold rounded-t-sm transition border-b-2 border-stone-900 text-stone-900 bg-white';
            const classesInativa = 'tab-btn-nova-conversa flex-1 py-1.5 px-3 text-xs font-semibold rounded-t-sm transition border-b-2 border-transparent text-stone-500 hover:text-stone-800';

            tabBtnNumero.className = aba === 'numero' ? classesAtiva : classesInativa;
            tabBtnContato.className = aba === 'contato' ? classesAtiva : classesInativa;
            tabBtnGrupo.className = aba === 'grupo' ? classesAtiva : classesInativa;

            formNumero.classList.toggle('hidden', aba !== 'numero');
            formContato.classList.toggle('hidden', aba !== 'contato');
            formGrupo.classList.toggle('hidden', aba !== 'grupo');

            setTimeout(() => {
                if (aba === 'numero') document.getElementById('inputChatNumero')?.focus();
                else if (aba === 'contato') document.getElementById('inputContatoNome')?.focus();
                else if (aba === 'grupo') document.getElementById('inputGrupoNome')?.focus();
            }, 50);
        }

        function aoMudarPais(tipo) {
            const select = tipo === 'chat'
                ? document.getElementById('selectPaisChat')
                : document.getElementById('selectPaisContato');
            const flagImg = tipo === 'chat'
                ? document.getElementById('flagDisplayChat')
                : document.getElementById('flagDisplayContato');

            if (!select || !flagImg) return;
            const opt = select.options[select.selectedIndex];
            const iso = opt.getAttribute('data-iso') || 'br';
            flagImg.src = `https://flagcdn.com/w40/${iso}.png`;
            flagImg.alt = opt.textContent;

            // Se já tiver número digitado, revalida automaticamente com o novo código de país
            const input = tipo === 'chat' ? document.getElementById('inputChatNumero') : document.getElementById('inputContatoNumero');
            if (input && input.value.trim().length > 0) {
                aoDigitarNumeroVerificar(tipo);
            }
        }

        function obterNumeroCompletoComDdi(tipo) {
            const input = tipo === 'chat'
                ? document.getElementById('inputChatNumero')
                : document.getElementById('inputContatoNumero');
            const select = tipo === 'chat'
                ? document.getElementById('selectPaisChat')
                : document.getElementById('selectPaisContato');

            if (!input) return '';
            let val = input.value.replace(/\D/g, '');
            if (!val) return '';

            const ddi = select ? (select.value || '55') : '55';

            // Se o usuário já digitou o DDI explicitamente (ex: 5579991054091)
            if (val.startsWith(ddi) && val.length >= ddi.length + 9) {
                return val;
            }

            // Inserção automática do DDI selecionado na bandeira
            return `${ddi}${val}`;
        }

        function limparBadgeVerificacao(tipo) {
            const badge = tipo === 'chat'
                ? document.getElementById('badgeStatusNumeroChat')
                : document.getElementById('badgeStatusNumeroContato');
            if (badge) {
                badge.className = 'absolute right-3 top-2.5 text-[11px] hidden';
                badge.textContent = '';
            }
        }

        function aoDigitarNumeroVerificar(tipo) {
            clearTimeout(debounceVerificacaoNumero);
            const input = tipo === 'chat'
                ? document.getElementById('inputChatNumero')
                : document.getElementById('inputContatoNumero');
            const badge = tipo === 'chat'
                ? document.getElementById('badgeStatusNumeroChat')
                : document.getElementById('badgeStatusNumeroContato');

            if (!input || !badge) return;
            const digitos = input.value.replace(/\D/g, '');

            if (digitos.length < 8) {
                limparBadgeVerificacao(tipo);
                return;
            }

            const numeroCompleto = obterNumeroCompletoComDdi(tipo);

            badge.className = 'absolute right-3 top-2.5 text-[11px] text-amber-400 flex items-center gap-1';
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span><span>Checando...</span>';

            debounceVerificacaoNumero = setTimeout(async () => {
                try {
                    const res = await fetch('/admin/verificar-numero', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ numero: numeroCompleto })
                    });
                    const data = await res.json();
                    if (data.success && data.existe) {
                        badge.className = 'absolute right-3 top-2.5 text-[11px] text-emerald-400 font-semibold flex items-center gap-1';
