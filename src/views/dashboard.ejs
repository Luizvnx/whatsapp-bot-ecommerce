        }

        // ==========================================
        // 15. MÉTRICAS & CONTROLE GLOBAL DO BOT
        // ==========================================
        let botGlobalPausado = false;

        async function carregarStatusBotGlobal() {
            try {
                const res = await fetch('/admin/bot-status');
                const result = await res.json();
                if (result.success) {
                    botGlobalPausado = Boolean(result.pausado);
                    atualizarUiStatusBotGlobal();
                }
            } catch (err) {
                console.error('Erro ao consultar status global do bot:', err);
            }
        }

        function atualizarUiStatusBotGlobal() {
            const badge = document.getElementById('badgeBotStatusGlobal');
            const textoBtn = document.getElementById('textoBtnBotGlobal');
            const icone = document.getElementById('iconeStatusBotGlobal');
            const btn = document.getElementById('btnToggleBotGlobal');

            if (botGlobalPausado) {
                if (badge) {
                    badge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-rose-50 text-rose-700 border border-rose-200';
                    badge.textContent = 'Pausado';
                }
                if (textoBtn) textoBtn.textContent = '▶️ Retomar Bot Geral';
                if (btn) btn.className = 'px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition flex items-center gap-2 shadow-xs';
                if (icone) {
                    icone.className = 'w-11 h-11 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center text-2xl shadow-inner';
                    icone.textContent = '⏸️';
                }
            } else {
                if (badge) {
                    badge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
                    badge.textContent = 'Ativo';
                }
                if (textoBtn) textoBtn.textContent = '⏸️ Pausar Bot Geral';
                if (btn) btn.className = 'px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-xl text-xs font-bold transition flex items-center gap-2 shadow-xs';
                if (icone) {
                    icone.className = 'w-11 h-11 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center text-2xl shadow-inner';
                    icone.textContent = '🤖';
                }
            }
        }

        async function alternarStatusBotGlobal() {
            const novoStatus = !botGlobalPausado;
            const confirmMsg = novoStatus 
                ? 'Deseja realmente pausar o bot globalmente? Nenhum cliente receberá respostas automáticas até você reativar.'
                : 'Deseja reativar o bot globalmente para responder novos clientes?';

            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch('/admin/bot-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pausado: novoStatus })
                });

                const result = await res.json();
                if (result.success) {
                    botGlobalPausado = novoStatus;
                    atualizarUiStatusBotGlobal();
                    mostrarToast(result.message || 'Status do bot atualizado!', 'sucesso');
                } else {
                    mostrarToast(result.message || 'Erro ao alterar status do bot.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o servidor.', 'erro');
            }
        }

        async function carregarEstatisticas() {
            try {
                const res = await fetch('/admin/estatisticas');
                const result = await res.json();
                if (result.success && result.resumo) {
                    const r = result.resumo;
                    const elTotal = document.getElementById('statTotalGeral');
                    const elBot = document.getElementById('statTotalBot');
                    const elHumano = document.getElementById('statTotalHumano');
                    const elCarrinho = document.getElementById('statTotalCarrinho');
                    const elIa = document.getElementById('statTotalIa');

                    if (elTotal) elTotal.textContent = r.totalGeral || 0;
                    if (elBot) elBot.textContent = r.totalBot || 0;
                    if (elHumano) elHumano.textContent = r.totalHumano || 0;
                    if (elCarrinho) elCarrinho.textContent = r.totalCarrinho || 0;
                    if (elIa) elIa.textContent = r.totalIa || 0;
                }
            } catch (err) {
                console.error('Erro ao buscar estatísticas:', err);
            }
        }

        // ==========================================
        // 16. AÇÕES NO CHAT ATIVO: CARRINHO & DEVOLVER AO BOT
        // ==========================================
        function atualizarBadgeCarrinhoCliente(carrinho) {
            const badge = document.getElementById('badgeCarrinhoQtd');
            if (!badge) return;
            const qtd = Array.isArray(carrinho) 
                ? carrinho.reduce((sum, item) => sum + (parseInt(item.quantidade, 10) || 1), 0) 
                : 0;

            if (qtd > 0) {
                badge.textContent = qtd;
                badge.classList.remove('hidden');
            } else {
                badge.textContent = '0';
                badge.classList.add('hidden');
            }
        }

        function abrirModalCarrinhoCliente() {
            if (!conversaAtivaId || !conversaAtivaDados) {
                mostrarToast('Selecione uma conversa com o cliente primeiro.', 'info');
                return;
            }

            document.getElementById('carrinhoClienteNome').textContent = conversaAtivaDados.nome_contato || 'Cliente';
            const container = document.getElementById('carrinhoItensContainer');
            const totalEl = document.getElementById('carrinhoTotalValor');

            const carrinho = Array.isArray(conversaAtivaDados.carrinho) ? conversaAtivaDados.carrinho : [];

            if (carrinho.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-500 text-xs italic">
                        O carrinho deste cliente está vazio no momento.
                    </div>
                `;
                totalEl.textContent = 'R$ 0,00';
            } else {
                let totalSoma = 0;
                container.innerHTML = carrinho.map(item => {
                    const preco = parseFloat(item.preco) || 0;
                    const qtd = parseInt(item.quantidade, 10) || 1;
                    const subtotal = preco * qtd;
                    totalSoma += subtotal;

                    return `
                        <div class="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs">
                            <div>
                                <span class="font-bold text-slate-800 block">${escapeHtml(item.nome)}</span>
                                <span class="text-slate-500 text-[11px]">${qtd}x ${preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</span>
                            </div>
                            <span class="font-extrabold text-amber-600">${subtotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</span>
                        </div>
                    `;
                }).join('');

                totalEl.textContent = totalSoma.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }

            document.getElementById('modalCarrinhoCliente').classList.remove('hidden');
        }

        function fecharModalCarrinhoCliente() {
            document.getElementById('modalCarrinhoCliente').classList.add('hidden');
        }

        async function limparCarrinhoAtivo() {
            if (!conversaAtivaId) return;
            if (!confirm('Deseja realmente esvaziar todo o carrinho deste cliente?')) return;

            const btn = document.getElementById('btnEsvaziarCarrinho');
            btn.disabled = true;

            try {
                const res = await fetch('/admin/limpar-carrinho', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id_cliente: conversaAtivaId })
                });

                const result = await res.json();
                if (result.success) {
                    if (conversaAtivaDados) conversaAtivaDados.carrinho = [];
                    atualizarBadgeCarrinhoCliente([]);
                    abrirModalCarrinhoCliente();
                    mostrarToast(result.message || 'Carrinho esvaziado com sucesso!', 'sucesso');
                } else {
                    mostrarToast(result.message || 'Erro ao esvaziar carrinho.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação ao esvaziar carrinho.', 'erro');
            } finally {
                btn.disabled = false;
            }
        }

        function abrirModalDevolverBot() {
            if (!conversaAtivaId || !conversaAtivaDados) {
                mostrarToast('Selecione uma conversa com o cliente primeiro.', 'info');
                return;
            }
            document.getElementById('checkResetarCarrinhoDevolver').checked = false;
            document.getElementById('selectEtapaDevolucao').value = 'inicio';
            document.getElementById('modalDevolverBot').classList.remove('hidden');
        }

        function fecharModalDevolverBot() {
            document.getElementById('modalDevolverBot').classList.add('hidden');
        }

        async function confirmarDevolverBot() {
            if (!conversaAtivaId) return;

            const btn = document.getElementById('btnConfirmarDevolver');
            const novaEtapa = document.getElementById('selectEtapaDevolucao').value;
            const resetarCarrinho = document.getElementById('checkResetarCarrinhoDevolver').checked;

            btn.disabled = true;
            btn.textContent = 'Transferindo...';

            try {
                const res = await fetch('/admin/alterar-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id_cliente: conversaAtivaId,
                        novaEtapa: novaEtapa,
                        resetarCarrinho: resetarCarrinho
                    })
                });

                const result = await res.json();
                if (result.success) {
                    mostrarToast(result.message || 'Cliente transferido para o bot com sucesso!', 'sucesso');
                    fecharModalDevolverBot();
                    await carregarListaConversas();
                    await carregarMensagensConversaAtiva();
                } else {
                    mostrarToast(result.message || 'Erro ao transferir cliente.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o servidor.', 'erro');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Confirmar Devolução';
            }
        }

        // ==========================================
        // 17. CONFIGURAÇÕES DO USUÁRIO & PERFIL
        // ==========================================
        function abrirModalPerfil() {
            document.getElementById('perfilSenhaAtual').value = '';
            document.getElementById('perfilNovaSenha').value = '';
            document.getElementById('perfilConfirmaSenha').value = '';
            document.getElementById('modalPerfilUsuario').classList.remove('hidden');
        }

        function fecharModalPerfil() {
            document.getElementById('modalPerfilUsuario').classList.add('hidden');
        }

        async function salvarPerfil(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSalvarPerfil');
            const nome = document.getElementById('perfilNome').value.trim();
            const email = document.getElementById('perfilEmail').value.trim();
            const senhaAtual = document.getElementById('perfilSenhaAtual').value;
            const novaSenha = document.getElementById('perfilNovaSenha').value;
            const confirmaSenha = document.getElementById('perfilConfirmaSenha').value;

            if (!nome || !email) {
                mostrarToast('Nome e e-mail são obrigatórios.', 'erro');
                return;
            }

            if (novaSenha || confirmaSenha) {
                if (!senhaAtual) {
                    mostrarToast('Digite a senha atual para autorizar a troca de senha.', 'erro');
                    return;
                }
                if (novaSenha !== confirmaSenha) {
                    mostrarToast('A confirmação da nova senha não confere.', 'erro');
                    return;
                }
                if (novaSenha.length < 3) {
                    mostrarToast('A nova senha deve ter pelo menos 3 caracteres.', 'erro');
                    return;
                }
            }

            btn.disabled = true;
            btn.textContent = 'Salvando no banco...';

            try {
                const res = await fetch('/admin/perfil', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nome, email, senhaAtual, novaSenha })
                });

                const result = await res.json();
                if (result.success) {
                    mostrarToast(result.message || 'Perfil atualizado!', 'sucesso');
                    
                    const badgeNome = document.getElementById('userBadgeNome');
                    const badgeAvatar = document.getElementById('userBadgeAvatar');
                    if (badgeNome) badgeNome.textContent = nome;
                    if (badgeAvatar) badgeAvatar.textContent = nome.charAt(0).toUpperCase();

                    fecharModalPerfil();
                } else {
                    mostrarToast(result.message || 'Erro ao salvar perfil.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o servidor.', 'erro');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Salvar Alterações';
            }
        }

        // ==========================================
        // 11. INICIALIZAÇÃO DO SISTEMA
        // ==========================================
        document.addEventListener('click', () => {
            inicializarAudioContext();
        }, { once: true });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                fecharModalNovaConversa();
                fecharModalConfirmarApagar();
                fecharModalZoom();
                fecharModalResumo();
                fecharModalProduto();
                fecharModalCategoria();
                fecharModalCarrinhoCliente();
                fecharModalDevolverBot();
                fecharModalPerfil();
                fecharModalQrCode();
            }
        });

        atualizarIconeSom();
        atualizarIconeNotificacao();
        atualizarTudo();

        setInterval(carregarListaConversas, 15000);
        setInterval(monitorarInstancia, 30000);
    </script>
</body>

</html>