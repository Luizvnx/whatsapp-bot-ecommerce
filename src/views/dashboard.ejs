                mostrarToast('Por favor, informe um número de telefone válido com DDD.', 'erro');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span>⏳</span><span>Iniciando...</span>';

            try {
                const res = await fetch('/admin/novo-chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        numero: numeroCompleto,
                        nome: nome,
                        mensagemInicial: mensagem
                    })
                });

                const result = await res.json();
                if (result.success) {
                    mostrarToast(result.message || 'Conversa iniciada!', 'sucesso');
                    fecharModalNovaConversa();
                    await carregarListaConversas();
