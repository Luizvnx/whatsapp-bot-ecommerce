                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">E-mail / Usuário de Login *</label>
                    <input type="text" id="perfilEmail" required placeholder="Ex: admin@favodemel.com"
                        value="<%= (typeof user !=='undefined' && user && user.email) ? user.email : 'admin@favodemel.com' %>"
