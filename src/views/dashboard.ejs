                        }

                        // Se o modal estava aberto aguardando conexão, comemora e fecha
                        if (modalQrCodeAberto) {
                            document.getElementById('qrCodeModalLoading')?.classList.add('hidden');
                            document.getElementById('qrCodeModalImagemContainer')?.classList.add('hidden');
                            document.getElementById('qrCodeModalConectado')?.classList.remove('hidden');
