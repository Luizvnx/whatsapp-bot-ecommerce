<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-[#f6f5f3]">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Apiário Favo de Mel | Painel de Atendimento ao Vivo</title>

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#b45309">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Favo de Mel">

    <!-- Socket.io & Tailwind -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
                        serif: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
                        mono: ['"IBM Plex Mono"', 'ui-monospace', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
            --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
            --font-serif: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        html,
        body {
            font-family: var(--font-sans);
            height: 100%;
            height: 100dvh;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            overscroll-behavior: none;
            overscroll-behavior-y: none;
            -webkit-overflow-scrolling: touch;
        }

        /* Previne zoom automático indesejado no iOS / Safari / Android */
        @media screen and (max-width: 768px) {
            input, textarea, select {
                font-size: 16px !important;
            }
        }

        /* Isola a rolagem das mensagens e da lista para impedir que puxe a página */
        #chatMensagensStream,
        #listaConversas,
        .custom-scrollbar {
            overscroll-behavior-y: contain !important;
            overscroll-behavior: contain !important;
            -webkit-overflow-scrolling: touch !important;
            touch-action: pan-y !important;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d6d3d1;
            border-radius: 2px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #a8a29e;
        }

        .chat-bg {
            background-color: #f7f6f2;
            background-image: radial-gradient(#e5e4de 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>

<body class="h-full flex flex-col text-stone-900 antialiased overflow-hidden bg-[#f6f5f3]">

    <!-- Topbar Banner & Header -->
    <header class="bg-white border-b border-stone-200 sticky top-0 z-30 flex-shrink-0 shadow-xs">
        <div class="max-w-7xl mx-auto px-2.5 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-2">
            <!-- Brand Logo -->
            <div class="flex items-center gap-2.5 flex-shrink-0">
                <div class="w-9 h-9 rounded-full bg-white border border-stone-200/90 shadow-xs flex items-center justify-center overflow-hidden flex-shrink-0 p-0.5">
                    <img src="/logo.webp" alt="Apiário Favo de Mel" class="w-full h-full object-contain" onerror="this.onerror=null; this.src='/logo.png';">
                </div>
                <div class="hidden xs:block">
                    <h1 class="text-sm sm:text-base font-bold text-stone-900 leading-none">Apiário Favo de Mel</h1>
                    <p class="text-[10px] uppercase tracking-wider text-amber-800 font-semibold mt-0.5 hidden sm:block">Painel de Atendimento</p>
                </div>
            </div>

            <!-- Header Navigation Switcher (Desktop md:flex) -->
            <nav class="hidden md:flex items-center bg-stone-100 p-0.5 rounded-sm border border-stone-200">
                <button type="button" onclick="trocarAba('atendimento')" id="btnAbaAtendimento"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-semibold transition bg-stone-900 text-stone-100 shadow-xs">
                    <span>Atendimento</span>
                </button>
                <button type="button" onclick="trocarAba('catalogo')" id="btnAbaCatalogo"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-semibold transition text-stone-600 hover:text-stone-900 hover:bg-stone-200/60">
                    <span>Catálogo</span>
                </button>
                <button type="button" onclick="trocarAba('metricas')" id="btnAbaMetricas"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-sm text-xs font-semibold transition text-stone-600 hover:text-stone-900 hover:bg-stone-200/60">
                    <span>Métricas & Bot</span>
                </button>
            </nav>

            <!-- Header Status & Action Controls (Always visible on mobile & desktop) -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <!-- Socket Realtime Badge (Desktop only) -->
                <div id="badgeSocket" title="Status da Conexão em Tempo Real (WebSocket)"
                    class="hidden lg:flex items-center gap-1.5 text-[11px] font-mono font-medium bg-stone-50 px-2 py-1 rounded-sm border border-stone-200 text-stone-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    <span>Tempo Real</span>
                </div>

                <!-- Instance Status Button: Solid Green Background with White Text -->
                <button type="button" id="badgeStatus" onclick="clicarBadgeStatus()" title="Status da Conexão WhatsApp (Clique para ler QR Code se desconectado)"
                    class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-[#25D366] text-white shadow-xs hover:bg-[#20bd5a] transition cursor-pointer flex-shrink-0">
                    <span id="badgeStatusDot" class="w-2 h-2 rounded-full bg-white flex-shrink-0"></span>
                    <span id="badgeStatusText">WhatsApp Conectado</span>
                </button>

                <!-- Install PWA Button (Visível quando instalável) -->
                <button id="btnInstalarApp" onclick="instalarPWA()" title="Instalar aplicativo Favo de Mel no celular ou computador"
                    class="hidden flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-amber-600 hover:bg-amber-700 text-white shadow-xs transition cursor-pointer flex-shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    <span class="hidden sm:inline">Instalar App</span>
                </button>

                <!-- Sound Alert Toggle Button -->
                <button onclick="alternarSom()" id="btnToggleSom" title="Alerta sonoro (Clique para silenciar/ativar)"
                    class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white hover:bg-stone-100 text-stone-700 flex items-center justify-center border border-stone-200 shadow-xs flex-shrink-0 transition cursor-pointer">
                    <span id="iconSom" class="flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/>
                        </svg>
                    </span>
                </button>

                <!-- Refresh Button -->
                <button onclick="atualizarTudo(true)" title="Atualizar dados agora"
                    class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white hover:bg-stone-100 text-stone-700 flex items-center justify-center border border-stone-200 shadow-xs flex-shrink-0 transition cursor-pointer">
                    <svg id="iconRefresh" class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                        </path>
                    </svg>
                </button>

                <!-- User Profile Trigger Button: Round Icon only -->
                <button type="button" onclick="abrirModalPerfil()" title="Configurações do Usuário"
                    class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-stone-900 hover:bg-stone-800 text-amber-400 font-bold text-xs flex items-center justify-center border border-stone-700 shadow-xs transition hover:ring-2 hover:ring-amber-400 cursor-pointer flex-shrink-0">
                    <span id="userBadgeAvatar">
                        <%= (typeof user !=='undefined' && user && user.name) ? user.name.charAt(0).toUpperCase() : 'F' %>
                    </span>
                </button>

                <!-- Logout Button -->
                <a href="/logout" title="Sair do Painel"
                    class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white hover:bg-rose-50 text-stone-600 hover:text-rose-600 flex items-center justify-center border border-stone-200 hover:border-rose-300 shadow-xs transition flex-shrink-0">
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- Mobile Secondary Nav Bar (md:hidden) -->
        <div class="md:hidden border-t border-stone-200 px-3 py-1.5 bg-stone-50 flex items-center justify-center">
            <nav class="flex items-center w-full justify-between max-w-sm bg-stone-200/60 p-0.5 rounded-sm border border-stone-200">
                <button type="button" onclick="trocarAba('atendimento')" id="btnAbaAtendimentoMobile"
                    class="flex-1 py-1 text-center rounded-sm text-xs font-semibold transition bg-stone-900 text-stone-100 shadow-xs">
                    <span>Atendimento</span>
                </button>
                <button type="button" onclick="trocarAba('catalogo')" id="btnAbaCatalogoMobile"
                    class="flex-1 py-1 text-center rounded-sm text-xs font-semibold transition text-stone-600 hover:text-stone-900">
                    <span>Catálogo</span>
                </button>
                <button type="button" onclick="trocarAba('metricas')" id="btnAbaMetricasMobile"
                    class="flex-1 py-1 text-center rounded-sm text-xs font-semibold transition text-stone-600 hover:text-stone-900">
                    <span>Métricas & Bot</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Disconnection Alert Banner -->
    <div id="alertaConexao"
        class="hidden bg-stone-900 border-b border-stone-800 px-4 py-2 text-center text-xs text-stone-100 shadow-xs">
        <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-2.5">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-sm bg-stone-1000"></span>
                <span class="font-medium">WhatsApp desconectado. Conecte seu aparelho para sincronizar mensagens.</span>
            </div>
            <button type="button" onclick="abrirModalQrCode()"
                class="px-3 py-1 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-sm text-xs transition shadow-xs">
                <span>Escanear QR Code</span>
            </button>
        </div>
    </div>

    <!-- 1. ABA ATENDIMENTO (Conversas e Chat ao Vivo) -->
    <main id="abaConteudoAtendimento" class="flex-1 flex overflow-hidden max-w-7xl mx-auto w-full p-2 sm:p-3 gap-3">

        <!-- LEFT COLUMN: Conversation List (Sidebar) -->
        <section id="painelLista"
            class="w-full md:w-80 lg:w-96 bg-white border border-stone-200 rounded-md flex flex-col overflow-hidden flex-shrink-0 shadow-xs">

            <div class="p-3 border-b border-stone-200 space-y-2.5 bg-stone-50/50">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <h2 class="text-xs font-mono font-semibold text-stone-600 uppercase tracking-wider">Conversas</h2>
                        <span id="badgeTotalConversas"
                            class="text-[11px] font-mono font-semibold bg-white text-stone-700 border border-stone-200 px-1.5 py-0.5 rounded-sm">0</span>
                    </div>
                    <button type="button" onclick="abrirModalNovaConversa()" id="btnNovaConversa"
                        title="Iniciar nova conversa, contato ou grupo"
                        class="flex items-center gap-1.5 px-2.5 py-1 bg-stone-900 hover:bg-stone-800 text-stone-100 rounded-sm text-xs font-medium transition shadow-xs">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span>Nova Conversa</span>
                    </button>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-stone-400">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </span>
                    <input type="text" id="campoBusca" placeholder="Buscar por cliente ou telefone..."
                        oninput="aoDigitarBusca()"
                        class="w-full pl-8 pr-3 py-1.5 bg-white border border-stone-200 rounded-sm text-base md:text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:border-stone-900 transition">
                </div>
            </div>

            <div id="listaConversas" class="flex-1 overflow-y-auto custom-scrollbar divide-y divide-stone-100">
                <div class="p-8 text-center text-stone-400 font-mono text-xs">
                    Carregando conversas...
                </div>
            </div>
        </section>

        <!-- RIGHT COLUMN: Active Chat Panel -->
        <section id="painelChat"
            class="hidden md:flex flex-1 bg-white border border-stone-200 rounded-md flex-col overflow-hidden shadow-xs relative">

            <div id="chatEmptyState"
                class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-[#faf9f7]">
                <div
                    class="w-12 h-12 rounded-sm bg-white border border-stone-200 flex items-center justify-center mb-3 shadow-xs text-stone-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <h3 class="text-base font-serif font-semibold text-stone-900">Selecione uma conversa</h3>
                <p class="text-xs text-stone-500 max-w-sm mt-1">
                    Escolha um contato na lista para visualizar o histórico de mensagens e responder diretamente pelo WhatsApp.
                </p>
            </div>

            <div id="chatContent" class="hidden flex-1 flex flex-col h-full overflow-hidden">
                <div class="p-3 border-b border-stone-200 bg-white flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                        <button onclick="voltarParaLista()" type="button"
                            class="md:hidden p-1 text-stone-500 hover:text-stone-800 hover:bg-stone-100 rounded-sm transition flex-shrink-0"
                            title="Voltar para a lista">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>

                        <div id="chatHeaderAvatar"
                            class="w-8 h-8 rounded-sm bg-stone-100 text-stone-700 border border-stone-200 font-mono font-bold flex items-center justify-center text-xs shadow-xs flex-shrink-0">
                            C
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 id="chatHeaderNome" class="text-xs sm:text-sm font-semibold text-stone-900 leading-tight truncate">Nome do Cliente</h3>
                                <span id="badgeModoAtendimento" onclick="alternarModoAtendimento()"
                                    title="Clique para alternar o modo do Copiloto IA"
                                    class="cursor-pointer text-[10px] font-mono font-medium px-2 py-0.5 rounded-sm border bg-stone-50 text-stone-700 border-stone-200 hidden xs:inline-flex items-center gap-1.5 transition hover:bg-stone-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    <span id="textoModoAtendimento">Copiloto IA</span>
                                </span>
                            </div>
                            <span id="chatHeaderNumero" class="text-[10px] sm:text-xs font-mono text-stone-500 truncate block">0000000000</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">
                        <button onclick="abrirModalCarrinhoCliente()" id="btnVerCarrinho" title="Ver Carrinho do Cliente"
                            class="bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 px-2.5 py-1 rounded-sm text-xs font-medium transition flex items-center gap-1.5 shadow-xs">
                            <span>Carrinho</span>
                            <span id="badgeCarrinhoQtd" class="hidden px-1.5 py-0.2 bg-amber-600 text-white font-mono font-bold rounded-sm text-[10px]">0</span>
                        </button>

                        <button onclick="abrirModalDevolverBot()" id="btnDevolverBot" title="Transferir cliente de volta para o Bot"
                            class="bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 px-2.5 py-1 rounded-sm text-xs font-medium transition shadow-xs">
                            <span>Devolver ao Bot</span>
                        </button>

                        <button onclick="exportarChatParaTXT()" id="btnExportarTXT" title="Exportar histórico em TXT"
                            class="bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 px-2.5 py-1 rounded-sm text-xs font-medium transition shadow-xs">
                            <span class="hidden md:inline">Exportar TXT</span>
                            <span class="md:hidden">TXT</span>
                        </button>

                        <a id="btnAbrirWhatsappDirect" href="#" target="_blank"
                            class="bg-stone-900 hover:bg-stone-800 text-stone-100 px-2.5 py-1 rounded-sm text-xs font-medium transition flex items-center gap-1 shadow-xs">
                            <span>WhatsApp</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </a>
                    </div>
                </div>

                <div id="chatMensagensStream" class="flex-1 chat-bg p-3 sm:p-4 overflow-y-auto custom-scrollbar space-y-3">
                    <!-- Dynamic Message Bubbles -->
                </div>

                <div class="p-2.5 sm:p-3 border-t border-stone-200 bg-white relative">
                    <div id="barraRespostaMensagem"
                        class="hidden mb-2 p-2 bg-stone-50 border border-stone-200 rounded-sm flex items-center justify-between gap-2 shadow-xs">
                        <div class="flex items-center gap-2 overflow-hidden flex-1 border-l-2 border-stone-900 pl-2">
                            <div class="min-w-0 flex-1">
                                <span class="text-[10px] font-mono uppercase font-semibold text-stone-600">Respondendo a <span id="autorRespostaTexto">Cliente</span></span>
                                <p id="previewRespostaTexto" class="text-xs text-stone-800 truncate mt-0.5 font-medium"></p>
                            </div>
                        </div>
                        <button type="button" onclick="cancelarResposta()" title="Cancelar resposta (Esc)"
                            class="p-1 text-stone-400 hover:text-stone-700 bg-white rounded-sm border border-stone-200">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>

                    <input type="file" id="inputFileMidia" class="hidden"
                        accept="image/*,application/pdf,.doc,.docx,.xlsx,.txt" onchange="aoSelecionarArquivo(event)">

                    <form id="formChatNormal" onsubmit="enviarMensagem(event)" class="flex gap-1.5 sm:gap-2 items-end">
                        <button type="button" onclick="document.getElementById('inputFileMidia').click()"
                            title="Anexar arquivo ou imagem"
                            class="p-2 text-stone-600 hover:text-stone-900 bg-stone-50 border border-stone-200 hover:bg-stone-100 rounded-sm transition flex-shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                            </svg>
                        </button>

                        <div class="relative flex-1">
                            <textarea id="inputMensagemChat" placeholder="Digite uma mensagem..." rows="1"
                                autocomplete="off" onkeydown="aoPressionarTeclaMensagem(event)"
                                oninput="autoAjustarAlturaTextarea(this)"
                                class="w-full bg-stone-50/50 border border-stone-200 rounded-sm pl-3 pr-20 py-2 text-base md:text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition resize-none custom-scrollbar max-h-32 overflow-y-auto block leading-relaxed"></textarea>

                            <button type="button" onclick="sugerirRespostaIA()" id="btnSugerirIA"
                                title="Sugerir resposta com IA"
                                class="absolute right-2 top-1.5 px-2 py-0.5 text-[10px] font-mono uppercase font-semibold text-stone-700 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-sm transition flex items-center gap-1">
                                <span id="iconSugerirIA">IA</span>
                            </button>
                        </div>

                        <button type="button" onclick="iniciarGravacaoAudio()" id="btnGravarAudio"
                            title="Gravar mensagem de voz"
                            class="p-2 text-stone-600 hover:text-stone-900 bg-stone-50 border border-stone-200 hover:bg-stone-100 rounded-sm transition flex-shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                            </svg>
                        </button>

                        <button type="submit" id="btnEnviarMsg"
                            class="bg-stone-900 hover:bg-stone-800 text-stone-100 px-3.5 py-2 rounded-sm text-xs font-semibold uppercase tracking-wider transition shadow-xs flex items-center gap-1.5 flex-shrink-0">
                            <span class="hidden sm:inline">Enviar</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                        </button>
                    </form>

                    <div id="painelGravacaoAudio"
                        class="hidden flex items-center justify-between gap-3 bg-stone-100 border border-stone-300 rounded-sm px-3 py-2">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-rose-600"></span>
                            <span class="text-xs font-semibold text-stone-800">Gravação em andamento:</span>
                            <span id="tempoGravacao" class="text-xs font-mono font-bold text-stone-900">00:00</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="cancelarGravacaoAudio()" title="Cancelar gravação"
                                class="px-2.5 py-1 text-stone-700 hover:text-stone-900 bg-white border border-stone-300 rounded-sm text-xs font-medium transition">
                                Cancelar
                            </button>
                            <button type="button" onclick="finalizarEEnviarAudio()" title="Enviar áudio gravado"
                                class="bg-stone-900 hover:bg-stone-800 text-stone-100 px-3 py-1 rounded-sm text-xs font-semibold uppercase tracking-wide transition shadow-xs">
                                Enviar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- 2. ABA CATÁLOGO & PRODUTOS -->
    <div id="abaConteudoCatalogo" class="hidden flex-1 overflow-hidden max-w-7xl mx-auto w-full p-2 sm:p-3 flex-col gap-3">
        <div class="bg-white border border-stone-200 rounded-md p-3 sm:p-4 flex flex-wrap items-center justify-between gap-3 shadow-xs flex-shrink-0">
            <div>
                <h2 class="text-sm sm:text-base font-serif font-bold text-stone-900 leading-tight">Catálogo de Produtos & Preços</h2>
                <p class="text-[11px] sm:text-xs text-stone-500 font-mono">Sincronização em tempo real com o WhatsApp</p>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
                <div class="relative">
                    <input type="text" id="buscaProdutoCatalogo" placeholder="Buscar produto..." oninput="filtrarProdutosCatalogo()"
                        class="px-2.5 py-1.5 bg-stone-50 border border-stone-200 rounded-sm text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition w-36 sm:w-52">
                </div>

                <select id="filtroCategoriaCatalogo" onchange="filtrarProdutosCatalogo()"
                    class="py-1.5 px-2.5 bg-stone-50 border border-stone-200 rounded-sm text-xs text-stone-800 focus:outline-none focus:bg-white focus:border-stone-900 transition">
                    <option value="">Todas as Categorias</option>
                </select>

                <button type="button" onclick="abrirModalNovaCategoria()"
                    class="px-3 py-1.5 bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 rounded-sm text-xs font-medium transition shadow-xs">
                    <span>+ Categoria</span>
                </button>

                <button type="button" onclick="abrirModalNovoProduto()"
                    class="px-3.5 py-1.5 bg-stone-900 hover:bg-stone-800 text-stone-100 font-semibold rounded-sm text-xs transition shadow-xs">
                    <span>Novo Produto</span>
                </button>
            </div>
        </div>

        <div class="flex-1 bg-stone-50/50 border border-stone-200 rounded-md overflow-y-auto custom-scrollbar p-3 sm:p-4 shadow-xs">
            <div id="gridProdutosCatalogo" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                <div class="col-span-full text-center py-12 text-stone-400 font-mono text-xs">
                    Carregando catálogo de produtos...
                </div>
            </div>
        </div>
    </div>

    <!-- 3. ABA MÉTRICAS & CONTROLE DO BOT -->
    <div id="abaConteudoMetricas" class="hidden flex-1 overflow-y-auto custom-scrollbar max-w-7xl mx-auto w-full p-2 sm:p-3 flex-col gap-3">
        <div class="bg-white border border-stone-200 rounded-md p-4 shadow-xs flex flex-wrap items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-sm sm:text-base font-serif font-bold text-stone-900">Automação Global do Bot</h2>
                    <span id="badgeBotStatusGlobal" class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-sm bg-stone-100 text-stone-700 border border-stone-200">
                        Ativo
                    </span>
                </div>
                <p class="text-xs text-stone-500 mt-0.5">Pause o bot instantaneamente se desejar que apenas atendentes humanos falem no WhatsApp.</p>
            </div>

            <button type="button" id="btnToggleBotGlobal" onclick="alternarStatusBotGlobal()"
                class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-stone-100 rounded-sm text-xs font-semibold uppercase tracking-wider transition shadow-xs">
                <span id="textoBtnBotGlobal">Pausar Bot Geral</span>
            </button>
        </div>

        <!-- Metric Stat Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <div class="bg-white border border-stone-200 rounded-md p-3.5 shadow-xs">
                <span class="text-[11px] font-mono uppercase tracking-wider text-stone-500 font-medium block">Total de Clientes</span>
                <span id="statTotalGeral" class="text-2xl font-mono font-bold text-stone-900 mt-1 block">0</span>
                <span class="text-[10px] text-stone-400 mt-0.5 block">Sessões cadastradas</span>
            </div>
            <div class="bg-white border border-stone-200 rounded-md p-3.5 shadow-xs">
                <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-700 font-medium block">Com o Bot</span>
                <span id="statTotalBot" class="text-2xl font-mono font-bold text-emerald-600 mt-1 block">0</span>
                <span class="text-[10px] text-stone-400 mt-0.5 block">Navegando no catálogo</span>
            </div>
            <div class="bg-white border border-stone-200 rounded-md p-3.5 shadow-xs">
                <span class="text-[11px] font-mono uppercase tracking-wider text-stone-700 font-medium block">Atendimento Humano</span>
                <span id="statTotalHumano" class="text-2xl font-mono font-bold text-stone-800 mt-1 block">0</span>
                <span class="text-[10px] text-stone-400 mt-0.5 block">Em espera ou ao vivo</span>
            </div>
            <div class="bg-white border border-stone-200 rounded-md p-3.5 shadow-xs">
                <span class="text-[11px] font-mono uppercase tracking-wider text-amber-700 font-medium block">No Carrinho</span>
                <span id="statTotalCarrinho" class="text-2xl font-mono font-bold text-amber-600 mt-1 block">0</span>
                <span class="text-[10px] text-stone-400 mt-0.5 block">Montando pedido</span>
            </div>
            <div class="bg-white border border-stone-200 rounded-md p-3.5 shadow-xs">
                <span class="text-[11px] font-mono uppercase tracking-wider text-stone-600 font-medium block">Consultando IA</span>
                <span id="statTotalIa" class="text-2xl font-mono font-bold text-stone-700 mt-1 block">0</span>
                <span class="text-[10px] text-stone-400 mt-0.5 block">Assistente Gemini</span>
            </div>
        </div>

        <!-- Two Columns: Instance WhatsApp + Database Status -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="bg-white border border-stone-200 rounded-md p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-stone-100 pb-2">
                    <h3 class="text-xs font-mono font-semibold text-stone-800 uppercase tracking-wider">Conexão do WhatsApp</h3>
                    <span id="cardInstanciaStatusBadge" class="text-[11px] font-mono px-2 py-0.5 rounded-sm font-medium bg-stone-100 text-stone-600">Verificando...</span>
                </div>
                <p class="text-xs text-stone-500">Monitoramento da conexão do seu número no WhatsApp. Se desconectar, o QR Code de reconexão aparecerá abaixo.</p>
                <div id="cardInstanciaQrCode" class="text-center py-4 text-xs font-mono text-stone-500">
                    Conexão ativa e sincronizada.
                </div>
            </div>

            <div class="bg-white border border-stone-200 rounded-md p-4 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-stone-100 pb-2">
                    <h3 class="text-xs font-mono font-semibold text-stone-800 uppercase tracking-wider">Sincronização do Catálogo</h3>
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-sm font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Sincronizado e Ativo</span>
                </div>
                <p class="text-xs text-stone-500">Tabelas de catálogo, produtos, sessões e histórico sincronizados na nuvem.</p>
                <div class="pt-2 flex items-center gap-3">
                    <button type="button" onclick="carregarEstatisticas()" class="px-3.5 py-1.5 bg-stone-100 hover:bg-stone-200 border border-stone-200 text-xs font-medium text-stone-700 rounded-sm transition shadow-xs">
                        Atualizar Métricas
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE PRODUTO (NOVO OU EDITAR) -->
    <div id="modalProduto" class="hidden fixed inset-0 z-50 bg-stone-900/40 flex items-center justify-center p-4">
        <div class="bg-white border border-stone-300 rounded-md max-w-lg w-full p-5 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <h3 id="tituloModalProduto" class="text-base font-serif font-bold text-stone-900">Novo Produto</h3>
                <button type="button" onclick="fecharModalProduto()" class="text-stone-400 hover:text-stone-700 text-base">✕</button>
            </div>

            <form id="formProduto" onsubmit="salvarProduto(event)" class="space-y-3.5">
                <input type="hidden" id="prodEditId" value="">

                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Nome do Produto *</label>
                    <input type="text" id="prodEditNome" required placeholder="Ex: Mel de Flor de Laranjeira"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-stone-700 mb-1">Categoria *</label>
                        <select id="prodEditCategoria" required
                            class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 focus:outline-none focus:bg-white focus:border-stone-900">
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-stone-700 mb-1">Preço (R$) *</label>
                        <input type="number" id="prodEditPreco" required step="0.01" min="0" placeholder="Ex: 85.00"
                            class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Descrição</label>
                    <textarea id="prodEditDescricao" rows="2" placeholder="Breve descrição dos benefícios ou tamanho (ex: 250ml, medicinal...)"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 resize-none"></textarea>
                </div>

                <!-- Foto do Produto -->
                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Foto do Produto (enviada pelo Bot no WhatsApp)</label>
                    <div class="flex items-center gap-3 bg-stone-50 p-2.5 rounded-sm border border-stone-200">
                        <div id="prodEditFotoPreviewContainer" class="w-14 h-14 rounded-sm bg-white border border-stone-300 flex items-center justify-center overflow-hidden flex-shrink-0 relative shadow-2xs">
                            <img id="prodEditFotoPreview" src="" class="w-full h-full object-cover hidden">
                            <span id="prodEditFotoPlaceholder" class="text-2xl">🍯</span>
                        </div>
                        <div class="flex-1 min-w-0 space-y-1.5">
                            <div class="flex items-center gap-2">
                                <label for="prodEditFotoArquivo" class="px-2.5 py-1 bg-stone-900 hover:bg-stone-800 text-stone-100 rounded-sm text-xs font-semibold cursor-pointer transition shadow-xs flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <span>Escolher Foto</span>
                                </label>
                                <input type="file" id="prodEditFotoArquivo" accept="image/*" class="hidden" onchange="aoSelecionarFotoProduto(event)">
                                <button type="button" onclick="removerFotoProduto()" id="btnRemoverFotoProduto" class="hidden text-xs text-rose-600 hover:text-rose-700 font-semibold underline">
                                    Remover Foto
                                </button>
                            </div>
                            <input type="text" id="prodEditFotoUrl" placeholder="Ou cole a URL da imagem (https://...)" oninput="aoDigitarUrlFotoProduto(this.value)"
                                class="w-full bg-white border border-stone-300 rounded-sm px-2.5 py-1 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:border-stone-900">
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="prodEditAtivo" checked
                        class="w-4 h-4 rounded-sm border-stone-300 text-stone-900 focus:ring-stone-900">
                    <label for="prodEditAtivo" class="text-xs font-medium text-stone-700 cursor-pointer">
                        Produto ativo e visível no WhatsApp
                    </label>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t border-stone-200">
                    <button type="button" onclick="fecharModalProduto()"
                        class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-sm text-xs font-medium transition">
                        Cancelar
                    </button>
                    <button type="submit" id="btnSalvarProduto"
                        class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-stone-100 font-semibold rounded-sm text-xs transition shadow-xs">
                        Salvar Produto
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL DE NOVA CATEGORIA -->
    <div id="modalCategoria" class="hidden fixed inset-0 z-50 bg-stone-900/40 flex items-center justify-center p-4">
        <div class="bg-white border border-stone-300 rounded-md max-w-md w-full p-5 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <h3 class="text-base font-serif font-bold text-stone-900">Nova Categoria</h3>
                <button type="button" onclick="fecharModalCategoria()" class="text-stone-400 hover:text-stone-700 text-base">✕</button>
            </div>

            <form id="formCategoria" onsubmit="salvarCategoria(event)" class="space-y-3.5">
                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Código (ID) *</label>
                    <input type="text" id="catEditId" required placeholder="Ex: 4"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900">
                    <input type="hidden" id="catEditIcone" value="">
                </div>

                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Nome da Categoria *</label>
                    <input type="text" id="catEditNome" required placeholder="Ex: Sachês e Blends Especiais"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900">
                </div>

                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Descrição</label>
                    <textarea id="catEditDescricao" rows="2" placeholder="Subtítulo que aparecerá no menu do WhatsApp"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-1.5 text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 resize-none"></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t border-stone-200">
                    <button type="button" onclick="fecharModalCategoria()"
                        class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-sm text-xs font-medium transition">
                        Cancelar
                    </button>
                    <button type="submit" id="btnSalvarCategoria"
                        class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-stone-100 font-semibold rounded-sm text-xs transition shadow-xs">
                        Salvar Categoria
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL DO CARRINHO DO CLIENTE -->
    <div id="modalCarrinhoCliente" class="hidden fixed inset-0 z-50 bg-stone-900/40 flex items-center justify-center p-4">
        <div class="bg-white border border-stone-300 rounded-md max-w-md w-full p-5 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <div>
                    <h3 class="text-base font-serif font-bold text-stone-900">Carrinho do Cliente</h3>
                    <p id="carrinhoClienteNome" class="text-xs text-stone-500 font-mono">Cliente</p>
