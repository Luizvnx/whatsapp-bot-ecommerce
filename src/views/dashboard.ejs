        function abrirModalEditarProduto(id) {
            const prod = catalogoProdutosCache.find(p => String(p.id) === String(id));
            if (!prod) return;

            document.getElementById('prodEditId').value = prod.id;
            document.getElementById('prodEditNome').value = prod.nome || '';
            document.getElementById('prodEditCategoria').value = prod.categoria_id || '';
            document.getElementById('prodEditPreco').value = prod.preco || '';
            document.getElementById('prodEditDescricao').value = prod.descricao || '';
            document.getElementById('prodEditAtivo').checked = prod.ativo !== false;

            if (prod.foto) {
                fotoProdutoAtual = prod.foto;
                const imgPreview = document.getElementById('prodEditFotoPreview');
                const placeholder = document.getElementById('prodEditFotoPlaceholder');
                const btnRemover = document.getElementById('btnRemoverFotoProduto');
                const inputUrl = document.getElementById('prodEditFotoUrl');

                if (imgPreview) {
                    imgPreview.src = prod.foto;
                    imgPreview.classList.remove('hidden');
                }
                if (placeholder) placeholder.classList.add('hidden');
                if (btnRemover) btnRemover.classList.remove('hidden');
                if (inputUrl) {
                    inputUrl.value = prod.foto.startsWith('data:') ? '' : prod.foto;
                }
            } else {
                removerFotoProduto();
            }

            document.getElementById('tituloModalProduto').textContent = 'Editar Produto';
            document.getElementById('btnSalvarProduto').textContent = 'Salvar Alterações';
