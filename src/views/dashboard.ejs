                    mostrarToast(result.message || 'Não foi possível gerar sugestão.', 'erro');
                }
            } catch (err) {
                mostrarToast('Erro ao consultar IA Gemini.', 'erro');
            } finally {
                btnIcon.textContent = '✨';
            }
        }

