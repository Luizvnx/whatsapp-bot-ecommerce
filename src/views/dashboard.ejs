        async function exportarChatParaTXT() {
            if (!conversaAtivaId) {
                mostrarToast('Selecione uma conversa para exportar.', 'info');
                return;
            }

            try {
                mostrarToast('Gerando arquivo TXT do chat...', 'info');
                const res = await fetch(`/admin/conversa/${encodeURIComponent(conversaAtivaId)}/exportar-txt`);
                if (!res.ok) {
                    mostrarToast('Erro ao gerar arquivo TXT.', 'erro');
                    return;
                }

                const textContent = await res.text();
                const numeroLimpo = conversaAtivaId.split('@')[0];
                const blob = new Blob([textContent], { type: 'text/plain;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `chat_${numeroLimpo}_${new Date().toISOString().slice(0, 10)}.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                mostrarToast('Histórico exportado em TXT com sucesso.', 'sucesso');
            } catch (err) {
                console.error('Erro ao exportar TXT:', err);
                mostrarToast('Falha ao baixar o histórico em TXT.', 'erro');
            }
        }

        async function alternarModoAtendimento() {
            if (!conversaAtivaId || !conversaAtivaDados) return;

            const modoAtual = conversaAtivaDados.modo_atendimento || 'copiloto';
            const novoModo = modoAtual === 'copiloto' ? 'humano' : 'copiloto';

            try {
                const res = await fetch(`/admin/conversa/${encodeURIComponent(conversaAtivaId)}/alternar-modo`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ modo: novoModo })
                });

                const result = await res.json();
                if (result.success) {
                    conversaAtivaDados.modo_atendimento = result.modo;
                    atualizarBadgeModo(result.modo);
                    mostrarToast(`Modo alterado para: ${result.modo === 'copiloto' ? 'Copiloto IA' : 'Atendimento Humano'}`, 'sucesso');
