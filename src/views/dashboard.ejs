            </form>

            <!-- Tab 3: Novo Grupo -->
            <form id="formNovoGrupo" onsubmit="submeterNovoGrupo(event)"
                class="hidden p-4 sm:p-5 space-y-3.5 flex-1 overflow-y-auto custom-scrollbar">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Nome do Grupo (Assunto) <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="inputGrupoNome" placeholder="Ex: Clientes Favo de Mel, Pedidos Especiais..." required
                        maxlength="100"
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
