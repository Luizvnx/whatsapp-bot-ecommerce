                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nova Senha</label>
                            <input type="password" id="perfilNovaSenha" placeholder="Nova senha"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-amber-500/40">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Confirmar Nova Senha</label>
                            <input type="password" id="perfilConfirmaSenha" placeholder="Repita a nova senha"
