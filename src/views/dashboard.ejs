                </button>
                <button type="button" onclick="fecharModalCarrinhoCliente()"
                    class="px-4 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-sm text-xs font-medium transition">
                    Fechar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE DEVOLVER AO BOT -->
    <div id="modalDevolverBot" class="hidden fixed inset-0 z-50 bg-stone-900/40 flex items-center justify-center p-4">
        <div class="bg-white border border-stone-300 rounded-md max-w-md w-full p-5 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <div>
                    <h3 class="text-base font-serif font-bold text-stone-900">Devolver Cliente para o Bot</h3>
                    <p class="text-xs text-stone-500">Selecione o estágio em que a automação reassume a conversa</p>
                </div>
                <button type="button" onclick="fecharModalDevolverBot()" class="text-stone-400 hover:text-stone-700 text-base">✕</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-stone-700 mb-1">Etapa de Destino:</label>
                    <select id="selectEtapaDevolucao"
                        class="w-full bg-stone-50/50 border border-stone-300 rounded-sm px-3 py-2 text-xs text-stone-900 focus:outline-none focus:bg-white focus:border-stone-900">
