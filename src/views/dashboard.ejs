                    </div>
                </div>
            `;
        }

        // ==========================================
        // 3.1. GERENCIADOR DE RESPOSTA A MENSAGEM (REPLY)
        // ==========================================
        function iniciarResposta(id) {
            if (!id || !conversaAtivaDados || !Array.isArray(conversaAtivaDados.historicoMensagens)) return;

            const msg = conversaAtivaDados.historicoMensagens.find(m => m.id === id || m.whatsappMessageId === id);
            if (!msg) return;

            const isAtendente = msg.remetente === 'atendente';
            const autor = isAtendente 
                ? (msg.atendenteNome ? `Você (${msg.atendenteNome})` : 'Você') 
                : (conversaAtivaDados.nome_contato || 'Cliente');

            let preview = msg.texto || '';
            if (msg.tipo && msg.tipo !== 'texto') {
                const icones = {
                    audio: '🎙️ Mensagem de Voz',
                    imagem: '🖼️ Imagem',
                    video: '🎥 Vídeo',
                    documento: `📄 ${msg.fileName || 'Documento'}`,
                    figurinha: '🎨 Figurinha'
                };
                preview = msg.texto && !msg.texto.startsWith('[') ? `${icones[msg.tipo] || msg.tipo}: ${msg.texto}` : (icones[msg.tipo] || msg.tipo);
            }

            mensagemRespondendo = {
                id: msg.id,
                whatsappMessageId: msg.whatsappMessageId || msg.id,
                remoteJid: conversaAtivaId,
                fromMe: isAtendente,
                autor: autor,
                remetente: msg.remetente,
                texto: preview.replace(/\r?\n/g, ' ').substring(0, 100),
                tipo: msg.tipo || 'texto'
            };

            const barra = document.getElementById('barraRespostaMensagem');
            const autorEl = document.getElementById('autorRespostaTexto');
            const previewEl = document.getElementById('previewRespostaTexto');

            if (barra && autorEl && previewEl) {
                autorEl.textContent = autor;
                previewEl.textContent = preview;
                barra.classList.remove('hidden');
            }

            const input = document.getElementById('inputMensagemChat');
            if (input) {
                input.focus();
            }
        }

        function cancelarResposta() {
            mensagemRespondendo = null;
            const barra = document.getElementById('barraRespostaMensagem');
            if (barra) {
                barra.classList.add('hidden');
            }
        }

        function rolarParaMensagem(targetId) {
            if (!targetId) return;
            const stream = document.getElementById('chatMensagensStream');
            if (!stream) return;

            let el = document.getElementById(`msg-${targetId}`);
            if (!el) {
                el = stream.querySelector(`[data-msg-id="${targetId}"]`) || stream.querySelector(`[data-whatsapp-id="${targetId}"]`);
            }

            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ring-2', 'ring-emerald-400', 'bg-emerald-500/10', 'rounded-xl', 'transition-all', 'duration-500');
                setTimeout(() => {
                    el.classList.remove('ring-2', 'ring-emerald-400', 'bg-emerald-500/10');
                }, 1800);
            } else {
                mostrarToast('A mensagem citada é anterior ou não foi carregada no histórico visível.', 'info');
            }
        }

        // ==========================================
        // 3.2. GERENCIADOR DE EXCLUSÃO DE MENSAGEM (APAGAR PARA TODOS)
        // ==========================================
        function confirmarApagarMensagem(idMensagem, whatsappMessageId) {
            if (!conversaAtivaId || !idMensagem) return;
            mensagemParaApagar = {
                id_cliente: conversaAtivaId,
                id_mensagem: idMensagem,
                whatsappMessageId: whatsappMessageId || idMensagem
            };

            const modal = document.getElementById('modalConfirmarApagar');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }

        function fecharModalConfirmarApagar() {
            const modal = document.getElementById('modalConfirmarApagar');
            if (modal) {
                modal.classList.add('hidden');
            }
            mensagemParaApagar = null;
            const btn = document.getElementById('btnConfirmarApagar');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Apagar para Todos</span>';
            }
        }

        async function executarApagarMensagemConfirmada() {
            if (!mensagemParaApagar || !mensagemParaApagar.id_cliente || !mensagemParaApagar.id_mensagem) {
                fecharModalConfirmarApagar();
                return;
            }

            const btn = document.getElementById('btnConfirmarApagar');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span><span>Apagando...</span>';
            }

            const payload = { ...mensagemParaApagar };

            try {
                const res = await fetch('/admin/apagar-mensagem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    mostrarToast('Mensagem apagada com sucesso!', 'sucesso');
                    fecharModalConfirmarApagar();

                    // Atualiza no cache de mensagens da conversa ativa
                    if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                        const msg = conversaAtivaDados.historicoMensagens.find(m => 
                            m.id === payload.id_mensagem || 
                            m.whatsappMessageId === payload.whatsappMessageId
                        );
                        if (msg) {
                            msg.apagada = true;
                            msg.apagadaPor = 'atendente';
                            msg.apagadaEm = new Date().toISOString();
                        }
                    }

                    // Atualiza a bolha na tela
                    atualizarBolhaMensagemApagada(payload.id_mensagem, 'atendente');
                    carregarListaConversas();
                } else {
                    mostrarToast(data.message || 'Não foi possível apagar a mensagem.', 'erro');
                }
            } catch (err) {
                console.error('Erro ao apagar mensagem:', err);
                mostrarToast('Falha na comunicação ao tentar apagar mensagem.', 'erro');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Apagar para Todos</span>';
                }
            }
        }

        function atualizarBolhaMensagemApagada(idMensagem, apagadaPor) {
            if (!idMensagem) return;
            const stream = document.getElementById('chatMensagensStream');
            if (!stream) return;

            let el = document.getElementById(`msg-${idMensagem}`);
            if (!el) {
                el = stream.querySelector(`[data-msg-id="${idMensagem}"]`) || stream.querySelector(`[data-whatsapp-id="${idMensagem}"]`);
            }

            if (!el) return;

            if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                const msg = conversaAtivaDados.historicoMensagens.find(m => 
                    m.id === idMensagem || 
                    m.whatsappMessageId === idMensagem ||
                    (m.id && idMensagem && (m.id.includes(idMensagem) || idMensagem.includes(m.id)))
                );
                if (msg) {
                    msg.apagada = true;
                    msg.apagadaPor = apagadaPor || msg.apagadaPor || 'cliente';
                    const isAtendente = msg.remetente === 'atendente';
                    const hora = formatarData(msg.timestamp);
                    el.innerHTML = renderizarBolhaMensagem(msg, isAtendente, conversaAtivaDados.nome_contato, hora);
                }
            }
        }

        // ==========================================
        // 4. GRAVADOR DE ÁUDIO NO NAVEGADOR (MediaRecorder)
        // ==========================================
        async function iniciarGravacaoAudio() {
            if (!conversaAtivaId) return;

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) audioChunks.push(e.data);
                };

                mediaRecorder.start();
                segundosGravacao = 0;

                // UI
                document.getElementById('formChatNormal').classList.add('hidden');
                document.getElementById('painelGravacaoAudio').classList.remove('hidden');
                document.getElementById('tempoGravacao').textContent = '00:00';

                timerGravacaoInterval = setInterval(() => {
                    segundosGravacao++;
                    const min = String(Math.floor(segundosGravacao / 60)).padStart(2, '0');
                    const sec = String(segundosGravacao % 60).padStart(2, '0');
                    document.getElementById('tempoGravacao').textContent = `${min}:${sec}`;
                }, 1000);

            } catch (err) {
                console.error('Erro ao acessar microfone:', err);
                mostrarToast('Não foi possível acessar o microfone. Verifique as permissões.', 'erro');
            }
        }

        function cancelarGravacaoAudio() {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
            }
            clearInterval(timerGravacaoInterval);
            audioChunks = [];

            document.getElementById('painelGravacaoAudio').classList.add('hidden');
            document.getElementById('formChatNormal').classList.remove('hidden');
        }

        async function finalizarEEnviarAudio() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') return;

            mediaRecorder.onstop = async () => {
                const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                mediaRecorder.stream.getTracks().forEach(track => track.stop());

                const reader = new FileReader();
                reader.readAsDataURL(audioBlob);
                reader.onloadend = async () => {
                    const base64Audio = reader.result;

                    try {
                        mostrarToast('Enviando áudio...', 'info');
                        const payloadAudio = {
                            id_cliente: conversaAtivaId,
                            audioBase64: base64Audio
                        };
                        if (mensagemRespondendo) {
                            payloadAudio.quoted = { ...mensagemRespondendo };
                            cancelarResposta();
                        }

                        const res = await fetch('/admin/enviar-audio', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payloadAudio)
                        });

                        const result = await res.json();
                        if (result.success) {
                            mostrarToast('Áudio enviado com sucesso!', 'sucesso');
                        } else {
                            mostrarToast(result.message || 'Erro ao enviar áudio', 'erro');
                        }
                    } catch (err) {
                        mostrarToast('Falha na comunicação ao enviar áudio.', 'erro');
                    }
                };
            };

            mediaRecorder.stop();
            clearInterval(timerGravacaoInterval);
            document.getElementById('painelGravacaoAudio').classList.add('hidden');
            document.getElementById('formChatNormal').classList.remove('hidden');
        }

        // ==========================================
        // 5. ENVIO DE ANEXOS, CLIPBOARD (PASTE) & MODAIS
        // ==========================================
        function processarArquivoAnexo(file) {
            if (!file) return;
            if (!conversaAtivaId) {
                mostrarToast('Selecione uma conversa ativa para enviar imagens ou anexos.', 'info');
                return;
            }

            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onloadend = () => {
                const base64 = reader.result;
                const isImage = file.type.startsWith('image/');
                const isVideo = file.type.startsWith('video/');

                let mediatype = 'document';
                if (isImage) mediatype = 'image';
                else if (isVideo) mediatype = 'video';

                const fileName = (file.name && file.name !== 'image.png') ? file.name : `imagem_colada_${Date.now()}.png`;

                anexoSelecionado = {
                    file: file,
                    base64: base64,
                    mediatype: mediatype,
                    mimetype: file.type || (isImage ? 'image/png' : isVideo ? 'video/mp4' : 'application/pdf'),
                    fileName: fileName
                };

                const container = document.getElementById('previewAnexoContainer');
                if (isImage) {
                    container.innerHTML = `
                        <img src="${base64}" class="max-h-44 rounded-xl object-contain shadow-sm mb-2 border border-slate-200">
                        <span class="text-xs text-slate-500 font-semibold">${fileName} (${(file.size / 1024).toFixed(1)} KB)</span>
                    `;
                } else if (isVideo) {
                    container.innerHTML = `
                        <video src="${base64}" controls class="max-h-44 rounded-xl object-contain shadow-sm mb-2 border border-slate-200"></video>
                        <span class="text-xs text-slate-500 font-semibold">${fileName} (${(file.size / 1024).toFixed(1)} KB)</span>
                    `;
                } else {
                    container.innerHTML = `
                        <div class="text-4xl mb-2">📄</div>
                        <span class="text-xs text-slate-800 font-bold truncate max-w-xs">${fileName}</span>
                        <span class="text-[11px] text-slate-500 mt-1">${(file.size / 1024).toFixed(1)} KB</span>
                    `;
                }

                document.getElementById('inputLegendaAnexo').value = '';
                document.getElementById('modalAnexo').classList.remove('hidden');
                setTimeout(() => document.getElementById('inputLegendaAnexo').focus(), 50);
            };
        }

        function aoSelecionarArquivo(event) {
            const file = event.target.files[0];
            if (file) processarArquivoAnexo(file);
            event.target.value = '';
        }

        // Suporte para Colar Imagens/Arquivos da Área de Transferência (Ctrl + V)
        document.addEventListener('paste', (event) => {
            const items = (event.clipboardData || window.clipboardData)?.items;
            if (!items) return;

            for (const item of items) {
                if (item.type.indexOf('image') !== -1 || item.type.indexOf('video') !== -1 || item.kind === 'file') {
                    const file = item.getAsFile();
                    if (file) {
                        event.preventDefault();
                        processarArquivoAnexo(file);
                        break;
                    }
                }
            }
        });

        // Suporte para Drag and Drop de Imagens/Arquivos no Painel de Chat
        const chatPanelEl = document.getElementById('painelChat');
        if (chatPanelEl) {
            chatPanelEl.addEventListener('dragover', (e) => e.preventDefault());
            chatPanelEl.addEventListener('drop', (e) => {
                e.preventDefault();
                if (e.dataTransfer?.files?.length > 0) {
                    processarArquivoAnexo(e.dataTransfer.files[0]);
                }
            });
        }

        function fecharModalAnexo() {
            document.getElementById('modalAnexo').classList.add('hidden');
            anexoSelecionado = null;
        }

        async function enviarAnexoConfirmado() {
            if (!anexoSelecionado || !conversaAtivaId) return;

            const legenda = document.getElementById('inputLegendaAnexo').value.trim();
            const payload = {
                id_cliente: conversaAtivaId,
                mediaBase64: anexoSelecionado.base64,
                mediatype: anexoSelecionado.mediatype,
                mimetype: anexoSelecionado.mimetype,
                fileName: anexoSelecionado.fileName,
                caption: legenda
            };

            if (mensagemRespondendo) {
                payload.quoted = { ...mensagemRespondendo };
                cancelarResposta();
            }

            fecharModalAnexo();
            mostrarToast('Enviando anexo...', 'info');

            try {
                const res = await fetch('/admin/enviar-midia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const errText = await res.text();
                    console.error('Erro HTTP ao enviar mídia:', res.status, errText);
                    mostrarToast(`Erro (${res.status}): Não foi possível processar o envio da mídia.`, 'erro');
                    return;
                }

                const result = await res.json();
                if (result.success) {
                    mostrarToast('Anexo enviado com sucesso!', 'sucesso');
                } else {
                    mostrarToast(result.message || 'Erro ao enviar anexo', 'erro');
                }
            } catch (err) {
                console.error('Erro ao enviar anexo:', err);
                mostrarToast('Falha na comunicação ao enviar anexo.', 'erro');
            }
        }

        // Lightbox Zoom
        function abrirModalZoom(src) {
            document.getElementById('imgZoomModal').src = src;
            document.getElementById('modalZoomImagem').classList.remove('hidden');
        }

        function fecharModalZoom() {
            document.getElementById('modalZoomImagem').classList.add('hidden');
        }

        // ==========================================
        // 6. COPILOTO IA GEMINI (SUGESTÃO, RESUMO & TAKEOVER)
