        // ==========================================
        function autoAjustarAlturaTextarea(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 128) + 'px';
        }

        function aoPressionarTeclaMensagem(event) {
            if (event.key === 'Escape') {
                if (mensagemRespondendo) {
                    event.preventDefault();
                    cancelarResposta();
                }
                return;
            }

            if (event.key === 'Enter') {
                if (event.ctrlKey || event.shiftKey) {
                    // Ctrl + Enter ou Shift + Enter -> Quebra de linha (vai para a linha de baixo)
                    event.preventDefault();
                    const input = event.target;
                    const start = input.selectionStart;
                    const end = input.selectionEnd;
                    input.value = input.value.substring(0, start) + '\n' + input.value.substring(end);
                    input.selectionStart = input.selectionEnd = start + 1;
                    autoAjustarAlturaTextarea(input);
                } else {
                    // Enter sozinho -> Envia a mensagem
                    event.preventDefault();
                    enviarMensagem(event);
                }
            }
        }

        async function enviarMensagem(event) {
            if (event) event.preventDefault();
            if (!conversaAtivaId) return;

            const input = document.getElementById('inputMensagemChat');
            const mensagem = input.value.trim();
            if (!mensagem) return;

            const quotedParaEnviar = mensagemRespondendo ? { ...mensagemRespondendo } : null;
            cancelarResposta();

            input.value = '';
            autoAjustarAlturaTextarea(input);
            input.focus();

            try {
                const res = await fetch('/admin/enviar-mensagem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id_cliente: conversaAtivaId,
                        mensagem: mensagem,
                        quoted: quotedParaEnviar
                    })
                });

                const result = await res.json();
                if (!result.success) {
                    mostrarToast(result.message || 'Erro ao enviar mensagem', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o servidor.', 'erro');
            }
        }

