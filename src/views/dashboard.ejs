                                <option value="1" data-iso="ca">🇨🇦 Canadá (+1)</option>
                                <option value="52" data-iso="mx">🇲🇽 México (+52)</option>
                                <option value="44" data-iso="gb">🇬🇧 Reino Unido (+44)</option>
                                <option value="39" data-iso="it">🇮🇹 Itália (+39)</option>
                                <option value="33" data-iso="fr">🇫🇷 França (+33)</option>
                                <option value="49" data-iso="de">🇩🇪 Alemanha (+49)</option>
                                <option value="56" data-iso="cl">🇨🇱 Chile (+56)</option>
                                <option value="57" data-iso="co">🇨🇴 Colômbia (+57)</option>
                                <option value="595" data-iso="py">🇵🇾 Paraguai (+595)</option>
                                <option value="598" data-iso="uy">🇺🇾 Uruguai (+598)</option>
