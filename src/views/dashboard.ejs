        let abaAtivaGeral = 'atendimento';

        function trocarAba(nomeAba) {
            abaAtivaGeral = nomeAba;
            
            const btnAtendimento = document.getElementById('btnAbaAtendimento');
            const btnCatalogo = document.getElementById('btnAbaCatalogo');
            const btnMetricas = document.getElementById('btnAbaMetricas');

            const abaAtendimento = document.getElementById('abaConteudoAtendimento');
            const abaCatalogo = document.getElementById('abaConteudoCatalogo');
            const abaMetricas = document.getElementById('abaConteudoMetricas');

            const resetBtn = (btn) => {
                if (!btn) return;
                btn.className = 'flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-500 hover:text-slate-800 hover:bg-slate-100';
            };
            const activeBtn = (btn, colorClass) => {
                if (!btn) return;
                btn.className = `flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition ${colorClass} text-white shadow-sm`;
            };

            resetBtn(btnAtendimento);
            resetBtn(btnCatalogo);
            resetBtn(btnMetricas);

            if (abaAtendimento) { abaAtendimento.classList.add('hidden'); abaAtendimento.classList.remove('flex'); }
            if (abaCatalogo) { abaCatalogo.classList.add('hidden'); abaCatalogo.classList.remove('flex'); }
            if (abaMetricas) { abaMetricas.classList.add('hidden'); abaMetricas.classList.remove('flex'); }

            if (nomeAba === 'atendimento') {
                activeBtn(btnAtendimento, 'bg-emerald-600');
                if (abaAtendimento) {
                    abaAtendimento.classList.remove('hidden');
                    abaAtendimento.classList.add('flex');
                }
            } else if (nomeAba === 'catalogo') {
                activeBtn(btnCatalogo, 'bg-amber-600');
                if (abaCatalogo) {
                    abaCatalogo.classList.remove('hidden');
                    abaCatalogo.classList.add('flex');
                }
                carregarCategoriasSelect();
                carregarProdutosCatalogo();
            } else if (nomeAba === 'metricas') {
                activeBtn(btnMetricas, 'bg-blue-600');
                if (abaMetricas) {
                    abaMetricas.classList.remove('hidden');
                    abaMetricas.classList.add('flex');
                }
                carregarEstatisticas();
                carregarStatusBotGlobal();
            }
        }

        // ==========================================
        // 14. GESTÃO DO CATÁLOGO & PRODUTOS (POSTGRESQL)
        // ==========================================
        let catalogoProdutosCache = [];
        let categoriasCache = [];

        async function carregarCategoriasSelect() {
            try {
                const res = await fetch('/admin/categorias');
                const result = await res.json();
                if (result.success && Array.isArray(result.data)) {
                    categoriasCache = result.data;

                    const filtroSelect = document.getElementById('filtroCategoriaCatalogo');
                    if (filtroSelect) {
                        const valAtual = filtroSelect.value;
                        filtroSelect.innerHTML = '<option value="">Todas as Categorias</option>' + 
                            categoriasCache.map(c => `<option value="${c.id}">${c.icone || '📁'} ${c.nome}</option>`).join('');
                        filtroSelect.value = valAtual;
                    }

                    const prodCatSelect = document.getElementById('prodEditCategoria');
                    if (prodCatSelect) {
                        prodCatSelect.innerHTML = '<option value="">Selecione uma categoria...</option>' + 
                            categoriasCache.map(c => `<option value="${c.id}">${c.icone || '📁'} ${c.nome}</option>`).join('');
                    }
                }
            } catch (err) {
                console.error('Erro ao carregar categorias:', err);
            }
        }

        async function carregarProdutosCatalogo() {
            const grid = document.getElementById('gridProdutosCatalogo');
            if (grid) {
                grid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-500 text-xs">⏳ Carregando produtos do banco de dados...</div>';
            }

            try {
                const res = await fetch('/admin/produtos');
                const result = await res.json();
                if (result.success && Array.isArray(result.data)) {
                    catalogoProdutosCache = result.data;
                    renderizarProdutosCatalogo(catalogoProdutosCache);
                } else {
                    if (grid) grid.innerHTML = '<div class="col-span-full text-center py-12 text-rose-400 text-xs">❌ Não foi possível carregar os produtos.</div>';
                }
            } catch (err) {
                console.error('Erro ao buscar produtos:', err);
                if (grid) grid.innerHTML = '<div class="col-span-full text-center py-12 text-rose-400 text-xs">❌ Erro de conexão com o banco de dados.</div>';
            }
        }

        function renderizarProdutosCatalogo(produtos) {
            const grid = document.getElementById('gridProdutosCatalogo');
            if (!grid) return;

            if (!produtos || produtos.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 text-slate-500 text-xs">
                        Nenhum produto cadastrado ou encontrado com o filtro atual.
                    </div>
                `;
                return;
            }

            grid.innerHTML = produtos.map(prod => {
                const precoNum = parseFloat(prod.preco) || 0;
                const precoFormatado = precoNum.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                const cat = categoriasCache.find(c => String(c.id) === String(prod.categoria_id));
                const nomeCat = cat ? `${cat.icone || '🍯'} ${cat.nome}` : `Categoria #${prod.categoria_id}`;
                const ativo = prod.ativo !== false;

                return `
                    <div class="bg-white border ${ativo ? 'border-slate-200' : 'border-rose-200 opacity-60'} rounded-2xl p-4 flex flex-col justify-between gap-3 shadow-xs hover:border-amber-400 transition">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 truncate">
                                    ${nomeCat}
                                </span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${ativo ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}">
                                    ${ativo ? 'Ativo' : 'Inativo'}
                                </span>
                            </div>
                            <h4 class="text-sm font-bold text-slate-900 leading-snug">${escapeHtml(prod.nome)}</h4>
                            <p class="text-xs text-slate-500 line-clamp-2">${escapeHtml(prod.descricao || 'Sem descrição cadastrada.')}</p>
                        </div>

                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
                            <div>
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Valor</span>
                                <span class="text-base font-extrabold text-amber-600">${precoFormatado}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="abrirModalEditarProduto('${prod.id}')"
                                    class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-xl text-xs font-semibold transition flex items-center gap-1 shadow-xs">
                                    <span>✏️</span>
                                    <span>Editar</span>
                                </button>
                                <button type="button" onclick="excluirProduto('${prod.id}', '${escapeHtml(prod.nome).replace(/'/g, "\\'")}')"
                                    class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-xl text-xs font-semibold transition" title="Excluir produto">
                                    <span>🗑️</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filtrarProdutosCatalogo() {
            const busca = (document.getElementById('buscaProdutoCatalogo')?.value || '').toLowerCase().trim();
            const catFiltro = document.getElementById('filtroCategoriaCatalogo')?.value;

            const filtrados = catalogoProdutosCache.filter(prod => {
                const matchTexto = !busca || 
                    (prod.nome && prod.nome.toLowerCase().includes(busca)) || 
                    (prod.descricao && prod.descricao.toLowerCase().includes(busca));
                const matchCat = !catFiltro || String(prod.categoria_id) === String(catFiltro);
                return matchTexto && matchCat;
            });

            renderizarProdutosCatalogo(filtrados);
        }

        function abrirModalNovoProduto() {
            document.getElementById('formProduto').reset();
            document.getElementById('prodEditId').value = '';
            document.getElementById('prodEditAtivo').checked = true;
            document.getElementById('tituloModalProduto').textContent = '🍯 Novo Produto';
            document.getElementById('btnSalvarProduto').textContent = 'Cadastrar Produto';
            document.getElementById('modalProduto').classList.remove('hidden');
            setTimeout(() => document.getElementById('prodEditNome')?.focus(), 80);
        }

        function abrirModalEditarProduto(id) {
            const prod = catalogoProdutosCache.find(p => String(p.id) === String(id));
            if (!prod) return;

            document.getElementById('prodEditId').value = prod.id;
            document.getElementById('prodEditNome').value = prod.nome || '';
            document.getElementById('prodEditCategoria').value = prod.categoria_id || '';
            document.getElementById('prodEditPreco').value = prod.preco || '';
            document.getElementById('prodEditDescricao').value = prod.descricao || '';
            document.getElementById('prodEditAtivo').checked = prod.ativo !== false;

            document.getElementById('tituloModalProduto').textContent = '✏️ Editar Produto';
            document.getElementById('btnSalvarProduto').textContent = 'Salvar Alterações';
            document.getElementById('modalProduto').classList.remove('hidden');
        }

        function fecharModalProduto() {
            document.getElementById('modalProduto').classList.add('hidden');
        }

        async function salvarProduto(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSalvarProduto');
            const id = document.getElementById('prodEditId').value.trim();
            const nome = document.getElementById('prodEditNome').value.trim();
            const categoria_id = document.getElementById('prodEditCategoria').value;
            const preco = parseFloat(document.getElementById('prodEditPreco').value);
            const descricao = document.getElementById('prodEditDescricao').value.trim();
            const ativo = document.getElementById('prodEditAtivo').checked;

            if (!nome || !categoria_id || isNaN(preco)) {
                mostrarToast('Preencha todos os campos obrigatórios corretamente.', 'erro');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Salvando no banco...';

            try {
                const url = id ? `/admin/produtos/${id}` : '/admin/produtos';
                const method = id ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nome, categoria_id, preco, descricao, ativo })
                });

                const result = await res.json();
                if (result.success) {
                    mostrarToast(result.message || 'Produto salvo com sucesso!', 'sucesso');
                    fecharModalProduto();
                    await carregarProdutosCatalogo();
                } else {
                    mostrarToast(result.message || 'Erro ao salvar produto.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação com o banco de dados.', 'erro');
            } finally {
                btn.disabled = false;
                btn.textContent = id ? 'Salvar Alterações' : 'Cadastrar Produto';
            }
        }

        async function excluirProduto(id, nome) {
            if (!confirm(`Deseja realmente remover o produto "${nome}" do catálogo?`)) return;

            try {
                const res = await fetch(`/admin/produtos/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    mostrarToast(result.message || 'Produto excluído!', 'sucesso');
                    await carregarProdutosCatalogo();
                } else {
                    mostrarToast(result.message || 'Erro ao excluir produto.', 'erro');
                }
            } catch (err) {
                mostrarToast('Falha na comunicação ao excluir produto.', 'erro');
            }
        }

