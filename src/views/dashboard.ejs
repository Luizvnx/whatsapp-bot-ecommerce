                        <div class="opacity-70 text-[11px] line-through border-t ${isAtendente ? 'border-emerald-300' : 'border-slate-200'} pt-1.5 max-w-xs break-words select-none text-slate-500">
                            ${conteudoCorpo}
                        </div>
                    </div>
                `;
            }

            let quotedHtml = '';
            if (msg.quoted && (msg.quoted.texto || msg.quoted.id)) {
                const autorCitado = msg.quoted.autor || (msg.quoted.remetente === 'atendente' ? 'Atendente' : (nomeContato || 'Cliente'));
                const textoCitado = formatarTextoMarkdown(msg.quoted.texto || '[Mensagem]');
                const borderCitado = isAtendente ? 'border-emerald-500 bg-emerald-50/80 text-slate-800' : 'border-emerald-500 bg-slate-50 text-slate-800';
                const autorCitadoCor = isAtendente ? 'text-emerald-700' : 'text-emerald-600';
                const targetId = (msg.quoted.id || msg.quoted.whatsappMessageId || '').replace(/'/g, "\\'");

                quotedHtml = `
                    <div onclick="rolarParaMensagem('${targetId}')" 
                         title="Clique para ir até a mensagem original"
                         class="mb-2 p-2 rounded-lg ${borderCitado} border-l-4 cursor-pointer hover:opacity-90 transition select-none group/quote shadow-xs">
                        <div class="flex items-center gap-1.5 text-[10px] font-bold ${autorCitadoCor} mb-0.5">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                            </svg>
                            <span class="truncate">${autorCitado}</span>
                        </div>
                        <p class="text-[11px] opacity-90 line-clamp-2 leading-snug break-words">${textoCitado}</p>
                    </div>
                `;
            }

            const safeMsgId = (msg.id || '').replace(/'/g, "\\'");
            const safeWhatsappId = (msg.whatsappMessageId || msg.id || '').replace(/'/g, "\\'");

            return `
                <div class="relative group max-w-[85%] sm:max-w-[75%] flex items-center gap-1.5 ${isAtendente ? 'flex-row-reverse' : 'flex-row'}">
                    <div class="${bgClass} px-3.5 py-2 shadow-xs w-full" ondblclick="iniciarResposta('${safeMsgId}')">
                        <span class="text-[10px] font-bold ${autorColor} block mb-1">${autor}</span>
                        ${quotedHtml}
                        ${conteudoCorpo}
                        <span class="text-[9px] ${horaColor} font-medium block text-right mt-1">${hora}</span>
                    </div>
                    <div class="opacity-0 group-hover:opacity-100 focus-within:opacity-100 flex items-center gap-1 transition flex-shrink-0">
                        <button type="button" onclick="iniciarResposta('${safeMsgId}')" title="Responder a esta mensagem (ou duplo-clique no balão)"
                            class="p-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-500 hover:text-slate-800 border border-slate-200 shadow-xs transition cursor-pointer text-xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                            </svg>
                        </button>
                        ${!isApagada ? `
                        <button type="button" onclick="confirmarApagarMensagem('${safeMsgId}', '${safeWhatsappId}')" title="Apagar mensagem para todos"
                            class="p-1.5 rounded-full bg-white hover:bg-rose-50 text-slate-500 hover:text-rose-600 border border-slate-200 hover:border-rose-200 shadow-xs transition cursor-pointer text-xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
