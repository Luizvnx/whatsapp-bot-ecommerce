<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-100">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Favo de Mel | Painel de Atendimento ao Vivo</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#f8fafc">

    <!-- Socket.io & Tailwind -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    borderRadius: {
                        '3xl': 'var(--radius-3xl)',
                        '2xl': 'var(--radius-2xl)',
                        'xl': 'var(--radius-xl)',
                        'lg': 'var(--radius-lg)',
                        'md': 'var(--radius-md)',
                        'sm': 'var(--radius-sm)',
                    },
                    fontFamily: {
                        sans: ['var(--font-sans)'],
                        mono: ['var(--font-mono)'],
                        serif: ['var(--font-serif)'],
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --radius-3xl: 4px;
            --radius-2xl: 4px;
            --radius-xl: 4px;
            --radius-lg: 4px;
            --radius-md: 4px;
            --radius-sm: 2px;

            --font-sans: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif;
            --font-mono: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif;
            --font-serif: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif;
        }

        html,
        body {
            font-family: var(--font-sans);
            height: 100%;
            height: 100dvh;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.4);
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(100, 116, 139, 0.6);
        }

        .chat-bg {
            background-color: #efeae2;
            background-image: radial-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fadeIn {
            animation: fadeIn 0.22s ease-out forwards;
        }
    </style>
</head>

<body class="h-full flex flex-col text-slate-800 antialiased overflow-hidden bg-slate-100">

    <!-- Topbar Banner & Header -->
    <header
        class="bg-white/95 backdrop-blur-md border-b border-slate-200 px-3 sm:px-4 py-2.5 sm:py-3 sticky top-0 z-30 flex-shrink-0 shadow-xs">
        <div class="max-w-7xl mx-auto flex justify-between items-center gap-2">
            <div class="flex items-center gap-2.5">
                <img src="/logo.png" alt="Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain flex-shrink-0"
                    onerror="this.onerror=null; this.src='/apple-touch-icon.png';">
                <div>
                    <h1 class="text-sm sm:text-base font-bold text-slate-900 leading-none">Favo de Mel</h1>
                    <p class="text-[11px] sm:text-xs text-amber-600 font-medium mt-0.5 hidden xs:block">Atendimento & Vendas</p>
                </div>
            </div>

            <!-- Header Navigation Switcher -->
            <nav class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 shadow-inner">
                <button type="button" onclick="trocarAba('atendimento')" id="btnAbaAtendimento"
                    class="flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-emerald-600 text-white shadow-sm">
                    <span>💬</span>
                    <span class="hidden sm:inline">Atendimento</span>
                </button>
                <button type="button" onclick="trocarAba('catalogo')" id="btnAbaCatalogo"
                    class="flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 hover:text-slate-900">
                    <span>🍯</span>
                    <span class="hidden sm:inline">Catálogo & Produtos</span>
                </button>
                <button type="button" onclick="trocarAba('metricas')" id="btnAbaMetricas"
                    class="flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 hover:text-slate-900">
                    <span>📊</span>
                    <span class="hidden sm:inline">Métricas & Bot</span>
                </button>
            </nav>

            <!-- Header Status & Action Controls -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <!-- Socket Realtime Badge -->
                <div id="badgeSocket" title="Status da Conexão em Tempo Real (WebSocket)"
                    class="hidden sm:flex items-center gap-1.5 text-[11px] font-semibold bg-emerald-50 px-2.5 py-1 rounded-xl border border-emerald-200 text-emerald-700">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Tempo Real</span>
                </div>

                <!-- Instance Status Button -->
                <button type="button" id="badgeStatus" onclick="clicarBadgeStatus()" title="Status da Conexão WhatsApp (Clique para ler QR Code se desconectado)"
                    class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-semibold bg-white px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl border border-slate-200 shadow-xs text-slate-600 hover:bg-slate-50 transition cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-slate-400 flex-shrink-0"></span>
                    <span id="badgeStatusText">Conectando...</span>
                </button>

                <!-- Sound Alert Toggle Button -->
                <button onclick="alternarSom()" id="btnToggleSom" title="Alerta Sonoro Ativo (Clique para silenciar)"
                    class="p-1.5 sm:p-2 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 rounded-xl transition border border-slate-200 flex-shrink-0 shadow-xs">
                    <span id="iconSom" class="text-xs sm:text-sm">🔊</span>
                </button>

                <!-- Push Notification Permission Toggle Button -->
                <button onclick="solicitarOuTestarNotificacao()" id="btnToggleNotif" title="Notificações no Navegador"
                    class="p-1.5 sm:p-2 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 rounded-xl transition border border-slate-200 flex-shrink-0 shadow-xs">
                    <span id="iconNotif" class="text-xs sm:text-sm">🔔</span>
                </button>

                <!-- Refresh Button -->
                <button onclick="atualizarTudo(true)" title="Atualizar dados agora"
                    class="p-1.5 sm:p-2 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 rounded-xl transition border border-slate-200 flex-shrink-0 shadow-xs">
                    <svg id="iconRefresh" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                        </path>
                    </svg>
                </button>

                <!-- User Identity Badge & Settings Button -->
                <div class="flex items-center gap-1.5 sm:gap-2 border-l border-slate-200 pl-2 sm:pl-3 ml-1 sm:ml-2">
                    <button type="button" onclick="abrirModalPerfil()" title="Configurações do Usuário e Senha"
                        class="flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-xs font-bold text-slate-800 transition cursor-pointer hover:border-amber-400 shadow-xs">
                        <span id="userBadgeAvatar"
                            class="w-5 h-5 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center text-[10px] font-extrabold shadow-xs">
                            <%= (typeof user !=='undefined' && user && user.name) ? user.name.charAt(0).toUpperCase() : 'F' %>
                        </span>
                        <span id="userBadgeNome" class="hidden md:inline text-slate-800 font-semibold">
                            <%= (typeof user !=='undefined' && user && user.name) ? user.name : 'Favo de Mel' %>
                        </span>
                        <span class="text-[10px] text-slate-400">⚙️</span>
                    </button>
                    <a href="/logout" title="Sair do Painel"
                        class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-600 hover:text-rose-600 transition flex items-center gap-1 shadow-xs">
                        <span>Sair</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Disconnection Alert Banner -->
    <div id="alertaConexao"
        class="hidden bg-rose-50 border-b border-rose-200 px-4 py-2.5 text-center text-xs font-semibold text-rose-800 shadow-xs">
        <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-2.5">
            <div class="flex items-center gap-2">
                <span class="text-base animate-pulse">⚠️</span>
                <span>WhatsApp Desconectado! Conecte seu aparelho para enviar e receber mensagens.</span>
            </div>
            <button type="button" onclick="abrirModalQrCode()"
                class="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-xl text-xs transition shadow-sm flex items-center gap-1.5 hover:scale-[1.02] active:scale-[0.98]">
                <span>📱</span>
                <span>Escanear QR Code</span>
            </button>
        </div>
    </div>

    <!-- 1. ABA ATENDIMENTO (Conversas e Chat ao Vivo) -->
    <main id="abaConteudoAtendimento" class="flex-1 flex overflow-hidden max-w-7xl mx-auto w-full p-2 sm:p-4 gap-3">

        <!-- LEFT COLUMN: Conversation List (Sidebar) -->
        <section id="painelLista"
            class="w-full md:w-80 lg:w-96 bg-white border border-slate-200 rounded-2xl flex flex-col overflow-hidden flex-shrink-0 shadow-sm">

            <!-- Sidebar Header & Search -->
            <div class="p-3 border-b border-slate-100 space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Conversas</h2>
                        <span id="badgeTotalConversas"
                            class="text-[11px] font-semibold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <!-- Botão Nova Conversa Estilo WhatsApp -->
                    <button type="button" onclick="abrirModalNovaConversa()" id="btnNovaConversa"
                        title="Iniciar nova conversa, adicionar contato ou criar grupo"
                        class="flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-xl text-xs font-semibold transition shadow-xs hover:scale-[1.02] active:scale-[0.98]">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4">
                            </path>
                        </svg>
                        <span>Nova Conversa</span>
                    </button>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </span>
                    <input type="text" id="campoBusca" placeholder="Buscar por cliente ou telefone..."
                        oninput="aoDigitarBusca()"
                        class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                </div>
            </div>

            <!-- Conversation List Items Container -->
            <div id="listaConversas" class="flex-1 overflow-y-auto custom-scrollbar divide-y divide-slate-100">
                <div class="p-8 text-center text-slate-400 text-xs italic">
                    ⏳ Carregando conversas em tempo real...
                </div>
            </div>

        </section>

        <!-- RIGHT COLUMN: Active Chat Panel -->
        <section id="painelChat"
            class="hidden md:flex flex-1 bg-white border border-slate-200 rounded-2xl flex-col overflow-hidden shadow-sm relative">

            <!-- Empty State (When no conversation is selected) -->
            <div id="chatEmptyState"
                class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-slate-50/50">
                <div
                    class="w-16 h-16 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-3xl mb-4 shadow-sm text-emerald-600">
                    💬
                </div>
                <h3 class="text-lg font-bold text-slate-800">Selecione uma conversa</h3>
                <p class="text-xs text-slate-500 max-w-sm mt-1">
                    Escolha um contato na lista à esquerda para acompanhar o histórico em tempo real e responder
                    diretamente pelo WhatsApp.
                </p>
            </div>

            <!-- Active Chat Content (Hidden initially) -->
            <div id="chatContent" class="hidden flex-1 flex flex-col h-full overflow-hidden">

                <!-- Chat Top Header -->
                <div
                    class="p-3 sm:p-3.5 border-b border-slate-200 bg-white/95 backdrop-blur-md flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1">
                        <!-- Back Button (Mobile only) -->
                        <button onclick="voltarParaLista()" type="button"
                            class="md:hidden p-1.5 -ml-1 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition flex-shrink-0"
                            title="Voltar para a lista de conversas">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                    d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>

                        <div id="chatHeaderAvatar"
                            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold flex items-center justify-center text-sm sm:text-base shadow-xs flex-shrink-0">
                            C
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 id="chatHeaderNome"
                                    class="text-xs sm:text-sm font-bold text-slate-900 leading-tight truncate">Nome do
                                    Cliente</h3>
                                <!-- Copilot Mode Switch Badge -->
                                <span id="badgeModoAtendimento" onclick="alternarModoAtendimento()"
                                    title="Clique para alternar o modo do Copiloto IA"
                                    class="cursor-pointer text-[10px] font-bold px-2 py-0.5 rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200 hidden xs:inline-flex items-center gap-1 transition hover:opacity-80">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    <span id="textoModoAtendimento">Copiloto IA</span>
                                </span>
                            </div>
                            <span id="chatHeaderNumero"
                                class="text-[10px] sm:text-xs font-mono text-slate-500 truncate block">📱
                                0000000000</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
                        <!-- Ver Carrinho Button -->
                        <button onclick="abrirModalCarrinhoCliente()" id="btnVerCarrinho" title="Ver Carrinho do Cliente"
                            class="bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 px-2.5 sm:px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold transition flex items-center gap-1.5 shadow-xs">
                            <span>🛒</span>
                            <span class="hidden md:inline">Carrinho</span>
                            <span id="badgeCarrinhoQtd" class="hidden px-1.5 py-0.5 bg-amber-500 text-slate-950 font-bold rounded-full text-[10px]">0</span>
                        </button>

                        <!-- Devolver ao Bot Button -->
                        <button onclick="abrirModalDevolverBot()" id="btnDevolverBot" title="Transferir cliente de volta para o Bot"
                            class="bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 px-2.5 sm:px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold transition flex items-center gap-1.5 shadow-xs">
                            <span>🤖</span>
                            <span class="hidden md:inline">Devolver ao Bot</span>
                        </button>

                        <!-- Download TXT Button -->
                        <button onclick="exportarChatParaTXT()" id="btnExportarTXT"
                            title="Baixar Histórico Completo do Chat em TXT"
                            class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-2.5 sm:px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold transition flex items-center gap-1.5 shadow-xs">
                            <span>📥</span>
                            <span class="hidden md:inline">Baixar TXT</span>
                        </button>

                        <!-- WhatsApp Direct Link -->
                        <a id="btnAbrirWhatsappDirect" href="#" target="_blank"
                            class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-2.5 sm:px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-semibold transition flex items-center gap-1.5 shadow-xs">
                            <span class="hidden sm:inline">WhatsApp Web</span>
                            <span class="sm:hidden">WhatsApp</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14">
                                </path>
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Chat Message Stream -->
                <div id="chatMensagensStream"
                    class="flex-1 chat-bg p-3 sm:p-4 overflow-y-auto custom-scrollbar space-y-3">
                    <!-- Dynamic Message Bubbles Rendered Here -->
                </div>

                <!-- Chat Input Footer -->
                <div class="p-2.5 sm:p-3 border-t border-slate-200 bg-white/95 backdrop-blur-md relative">

                    <!-- Barra de Resposta Ativa ("Respondendo a...") -->
                    <div id="barraRespostaMensagem"
                        class="hidden mb-2 p-2.5 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between gap-2.5 animate-fadeIn shadow-sm">
                        <div class="flex items-center gap-2.5 overflow-hidden flex-1 border-l-4 border-emerald-500 pl-2.5">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5 text-[11px] font-bold text-emerald-700">
                                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                                    </svg>
                                    <span>Respondendo a <span id="autorRespostaTexto">Cliente</span></span>
                                </div>
                                <p id="previewRespostaTexto" class="text-xs text-slate-700 truncate mt-0.5 font-medium"></p>
                            </div>
                        </div>
                        <button type="button" onclick="cancelarResposta()" title="Cancelar resposta (Esc)"
                            class="p-1.5 text-slate-400 hover:text-slate-700 bg-white hover:bg-slate-100 rounded-lg transition border border-slate-200 flex-shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Hidden File Input for Attachments -->
                    <input type="file" id="inputFileMidia" class="hidden"
                        accept="image/*,application/pdf,.doc,.docx,.xlsx,.txt" onchange="aoSelecionarArquivo(event)">

                    <!-- Normal Input Form -->
                    <form id="formChatNormal" onsubmit="enviarMensagem(event)" class="flex gap-1.5 sm:gap-2 items-end">

                        <!-- Attachment Button 📎 -->
                        <button type="button" onclick="document.getElementById('inputFileMidia').click()"
                            title="Enviar Imagem, PDF ou Documento"
                            class="p-2.5 text-slate-500 hover:text-slate-800 bg-slate-50 border border-slate-200 hover:bg-slate-100 rounded-xl transition flex-shrink-0 shadow-xs">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13">
                                </path>
                            </svg>
                        </button>

                        <!-- Text Input with Copilot Button -->
                        <div class="relative flex-1">
                            <textarea id="inputMensagemChat" placeholder="Digite uma mensagem..." rows="1"
                                autocomplete="off" onkeydown="aoPressionarTeclaMensagem(event)"
                                oninput="autoAjustarAlturaTextarea(this)"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-3.5 pr-9 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition resize-none custom-scrollbar max-h-32 overflow-y-auto block leading-relaxed"></textarea>

                            <!-- AI Suggest Button ✨ -->
                            <button type="button" onclick="sugerirRespostaIA()" id="btnSugerirIA"
                                title="Sugerir Resposta com IA Gemini"
                                class="absolute right-2 top-2 p-1 text-indigo-500 hover:text-indigo-700 transition text-sm flex items-center justify-center">
                                <span id="iconSugerirIA">✨</span>
                            </button>
                        </div>

                        <!-- Audio Record Button 🎙️ -->
                        <button type="button" onclick="iniciarGravacaoAudio()" id="btnGravarAudio"
                            title="Gravar Mensagem de Voz"
                            class="p-2.5 text-slate-500 hover:text-emerald-600 bg-slate-50 border border-slate-200 hover:bg-slate-100 rounded-xl transition flex-shrink-0 shadow-xs">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z">
                                </path>
                            </svg>
