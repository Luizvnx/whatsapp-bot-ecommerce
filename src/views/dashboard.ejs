                <button type="button" onclick="fecharModalDevolverBot()"
                    class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-sm text-xs font-medium transition">
                    Cancelar
                </button>
                <button type="button" onclick="confirmarDevolverBot()" id="btnConfirmarDevolver"
                    class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-stone-100 font-semibold rounded-sm text-xs transition shadow-xs">
                    Confirmar Devolução
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIGURAÇÃO DE USUÁRIO & SENHA -->
    <div id="modalPerfilUsuario" class="hidden fixed inset-0 z-50 bg-stone-900/40 flex items-center justify-center p-4">
        <div class="bg-white border border-stone-300 rounded-md max-w-md w-full p-5 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                <div>
                    <h3 class="text-base font-serif font-bold text-stone-900">Configurações de Usuário</h3>
                    <p class="text-xs text-stone-500">Credenciais e identificação do atendente</p>
