                            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-sm flex-shrink-0 border border-slate-200">
                                ${(item.nome_contato || 'C').charAt(0).toUpperCase()}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-baseline mb-1">
                                    <h4 class="text-xs font-bold text-slate-900 truncate">${item.nome_contato}</h4>
                                    <span class="text-[10px] text-slate-400 font-medium">${formatarData(item.ultima_msg)}</span>
                                </div>
                                <p class="text-xs text-slate-500 truncate">${item.preview || 'Sem mensagens'}</p>
                            </div>
                        `;
                        container.appendChild(div);
                    });
                }
            } catch (err) {
                console.error('Erro ao carregar lista de conversas:', err);
            } finally {
                estaCarregandoConversas = false;
