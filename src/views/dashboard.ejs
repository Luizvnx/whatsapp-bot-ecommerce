            grid.innerHTML = produtos.map(prod => {
                const precoNum = parseFloat(prod.preco) || 0;
                const precoFormatado = precoNum.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                const cat = categoriasCache.find(c => String(c.id) === String(prod.categoria_id));
                const nomeCat = cat ? cat.nome : `Categoria #${prod.categoria_id}`;
                const ativo = prod.ativo !== false;

                const fotoHtml = prod.foto 
                    ? `<div class="w-14 h-14 rounded-sm bg-stone-100 border border-stone-200 overflow-hidden flex-shrink-0 shadow-2xs"><img src="${prod.foto}" class="w-full h-full object-cover"></div>`
                    : `<div class="w-14 h-14 rounded-sm bg-amber-50 border border-amber-200 flex-shrink-0 flex items-center justify-center text-xl shadow-2xs">🍯</div>`;

                return `
                    <div class="bg-white border ${ativo ? 'border-slate-200' : 'border-rose-200 opacity-60'} rounded-sm p-4 flex flex-col justify-between gap-3 shadow-xs hover:border-amber-400 transition">
                        <div class="space-y-2.5">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-sm bg-stone-100 text-amber-800 border border-amber-200 truncate">
                                    ${nomeCat}
                                </span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${ativo ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}">
                                    ${ativo ? 'Ativo' : 'Inativo'}
                                </span>
                            </div>
                            
                            <div class="flex items-start gap-3">
                                ${fotoHtml}
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-bold text-slate-900 leading-snug truncate" title="${escapeHtml(prod.nome)}">${escapeHtml(prod.nome)}</h4>
                                    <p class="text-xs text-slate-500 line-clamp-2 mt-0.5">${escapeHtml(prod.descricao || 'Sem descrição cadastrada.')}</p>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
                            <div>
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Valor</span>
                                <span class="text-base font-extrabold text-amber-600">${precoFormatado}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="abrirModalEditarProduto('${prod.id}')"
                                    class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-sm text-xs font-semibold transition flex items-center gap-1 shadow-xs">
                                    <span>Editar</span>
                                </button>
                                <button type="button" onclick="excluirProduto('${prod.id}', '${escapeHtml(prod.nome).replace(/'/g, "\\'")}')"
                                    class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-sm text-xs font-semibold transition" title="Excluir produto">
                                    ✕
                                </button>
                            </div>
