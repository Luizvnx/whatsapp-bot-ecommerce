        async function carregarMensagensConversaAtiva() {
            if (!conversaAtivaId) return;

            try {
                const res = await fetch(`/admin/conversa/${encodeURIComponent(conversaAtivaId)}`);
                const result = await res.json();

                if (result.success && result.data) {
                    conversaAtivaDados = result.data;
                    const conversa = result.data;
                    const numeroLimpo = conversa.id_cliente.split('@')[0];

                    document.getElementById('chatHeaderNome').textContent = conversa.nome_contato || 'Cliente';
                    document.getElementById('chatHeaderNumero').textContent = `📱 ${numeroLimpo}`;
                    document.getElementById('chatHeaderAvatar').textContent = (conversa.nome_contato || 'C').charAt(0).toUpperCase();
                    document.getElementById('btnAbrirWhatsappDirect').href = `https://wa.me/${numeroLimpo}`;

                    atualizarBadgeModo(conversa.modo_atendimento || 'copiloto');
                    atualizarBadgeCarrinhoCliente(conversa.carrinho);

                    const stream = document.getElementById('chatMensagensStream');
                    const mensagens = conversa.historicoMensagens || [];

                    const noFim = (stream.scrollHeight - stream.scrollTop - stream.clientHeight) < 60;

                    if (mensagens.length === 0) {
                        stream.innerHTML = `
                            <div class="text-center py-12 text-slate-500 text-xs italic">
                                Nenhuma mensagem neste histórico.
                            </div>
                        `;
                    } else {
                        stream.innerHTML = mensagens.map(msg => {
                            const isAtendente = msg.remetente === 'atendente';
                            const hora = formatarData(msg.timestamp);
                            const msgId = msg.id ? `id="msg-${msg.id}" data-msg-id="${msg.id}" data-whatsapp-id="${msg.whatsappMessageId || ''}"` : '';
                            const divClass = isAtendente ? 'flex flex-col items-end' : 'flex flex-col items-start';

                            return `
                                <div ${msgId} class="${divClass} w-full">
                                    ${renderizarBolhaMensagem(msg, isAtendente, conversa.nome_contato, hora)}
                                </div>
                            `;
                        }).join('');
                    }

                    if (noFim || stream.children.length <= 5) {
                        stream.scrollTop = stream.scrollHeight;
                    }
                }
            } catch (err) {
                console.error('Erro ao carregar mensagens da conversa ativa:', err);
            }
        }

        // ==========================================
