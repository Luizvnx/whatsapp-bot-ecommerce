    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none font-mono"></div>

    <script>
        let conversaAtivaId = null;
        let conversaAtivaDados = null;
        let termoBusca = '';
        let timeoutBusca = null;
        let estaCarregandoConversas = false;

        // Estado do Gravador de Áudio
        let mediaRecorder = null;
        let audioChunks = [];
        let timerGravacaoInterval = null;
        let segundosGravacao = 0;

        // Estado do Modal de Anexo
        let anexoSelecionado = null; // { file, base64, mediatype, mimetype, fileName }

        // Estado de Resposta / Citação de Mensagem (Reply)
        let mensagemRespondendo = null; // { id, whatsappMessageId, texto, autor, remetente, tipo }

        // Estado de Exclusão de Mensagem (Apagar para todos)
        let mensagemParaApagar = null; // { id_cliente, id_mensagem, whatsappMessageId }

        // ==========================================
        // 1. ÁUDIO & NOTIFICAÇÕES NATIVAS (Web Audio API)
        // ==========================================
        let audioCtx = null;
        let somAtivo = localStorage.getItem('vip_som_ativo') !== 'false';

        function inicializarAudioContext() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (AudioContextClass) {
                    audioCtx = new AudioContextClass();
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function tocarSomNotificacao() {
            if (!somAtivo) return;
            try {
                inicializarAudioContext();
                if (!audioCtx) return;

                const agora = audioCtx.currentTime;
                const osc1 = audioCtx.createOscillator();
                const gain1 = audioCtx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(587.33, agora);
                gain1.gain.setValueAtTime(0, agora);
                gain1.gain.linearRampToValueAtTime(0.18, agora + 0.02);
                gain1.gain.exponentialRampToValueAtTime(0.001, agora + 0.35);
                osc1.connect(gain1);
                gain1.connect(audioCtx.destination);
                osc1.start(agora);
                osc1.stop(agora + 0.35);

                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(880.00, agora + 0.08);
                gain2.gain.setValueAtTime(0, agora + 0.08);
                gain2.gain.linearRampToValueAtTime(0.22, agora + 0.10);
                gain2.gain.exponentialRampToValueAtTime(0.001, agora + 0.50);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start(agora + 0.08);
                osc2.stop(agora + 0.50);
            } catch (e) {
                console.warn('Alerta sonoro:', e);
            }
        }

        function alternarSom() {
            inicializarAudioContext();
            somAtivo = !somAtivo;
            localStorage.setItem('vip_som_ativo', somAtivo);
            atualizarIconeSom();
            mostrarToast(somAtivo ? 'Alerta sonoro ativado' : 'Alerta sonoro silenciado', 'info');
            if (somAtivo) tocarSomNotificacao();
        }

        function atualizarIconeSom() {
            const btn = document.getElementById('btnToggleSom');
            const icon = document.getElementById('iconSom');
            if (btn && icon) {
                if (somAtivo) {
                    icon.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/></svg>';
                    btn.title = 'Alerta sonoro ativo';
                } else {
                    icon.innerHTML = '<svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>';
                    btn.title = 'Alerta sonoro silenciado';
                }
            }
        }

        async function solicitarOuTestarNotificacao() {
            if (!("Notification" in window)) {
                mostrarToast('Seu navegador não suporta notificações nativas.', 'erro');
                return;
            }

            if (Notification.permission === 'granted') {
                dispararNotificacaoNavegador('Favo de Mel', 'Notificações de atendimento ativas e funcionando!');
                mostrarToast('Notificações no navegador já estão ativas!', 'sucesso');
            } else if (Notification.permission !== 'denied') {
                const permission = await Notification.requestPermission();
                if (permission === 'granted') {
                    atualizarIconeNotificacao();
                    dispararNotificacaoNavegador('Favo de Mel', 'Notificações ativadas com sucesso!');
                    mostrarToast('Notificações ativadas com sucesso!', 'sucesso');
                } else {
                    atualizarIconeNotificacao();
                    mostrarToast('Permissão de notificação negada.', 'erro');
                }
            } else {
                mostrarToast('Notificações bloqueadas nas permissões do site.', 'erro');
            }
        }

        function dispararNotificacaoNavegador(titulo, corpo, idCliente = null) {
            if (!("Notification" in window) || Notification.permission !== 'granted') return;

            try {
                const notif = new Notification(titulo, {
                    body: corpo,
                    icon: '/favicon-32x32.png',
                    badge: '/favicon-16x16.png',
                    tag: idCliente || 'favodemel-whatsapp',
                    renotify: true
                });

                notif.onclick = () => {
                    window.focus();
                    if (idCliente) {
                        selecionarConversa(idCliente);
                    }
                    notif.close();
                };
            } catch (e) {
                console.warn('Erro ao disparar notificação nativa:', e);
            }
        }

        function atualizarIconeNotificacao() {
            const btn = document.getElementById('btnToggleNotif');
            const icon = document.getElementById('iconNotif');
            if (btn && icon) {
                if ("Notification" in window && Notification.permission === 'granted') {
                    icon.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>';
                    btn.title = 'Notificações ativas';
                } else {
                    icon.innerHTML = '<svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.73 21a2 2 0 01-3.46 0M18.63 13A17.89 17.89 0 0118 8m-6-5a4 4 0 00-4 4v1.5M3 3l18 18"/></svg>';
                    btn.title = 'Notificações inativas';
                }
            }
        }

        // ==========================================
        // 2. SOCKET.IO (TEMPO REAL & WEBSOCKET)
        // ==========================================
        const socket = io();

        socket.on('connect', () => {
            console.log('[Socket.io] Conectado ao servidor de eventos em tempo real.');
            const badge = document.getElementById('badgeSocket');
            if (badge) {
                badge.className = 'hidden sm:flex items-center gap-1.5 text-[11px] font-mono font-medium bg-stone-50 px-2 py-1 rounded-sm border border-stone-200 text-stone-700';
                badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span><span>Tempo Real</span>';
            }
        });

        socket.on('disconnect', () => {
            console.warn('[Socket.io] Conexão em tempo real desconectada.');
            const badge = document.getElementById('badgeSocket');
            if (badge) {
                badge.className = 'hidden sm:flex items-center gap-1.5 text-[11px] font-mono font-medium bg-stone-50 px-2 py-1 rounded-sm border border-amber-300 text-amber-800';
                badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-sm bg-stone-1000"></span><span>Reconectando...</span>';
            }
        });

        socket.on('nova_mensagem', (data) => {
            const { idCliente, nomeContato, mensagem } = data;
            const isAtendente = mensagem.remetente === 'atendente';

            const ehConversaAtiva = conversaAtivaId && (
                conversaAtivaId === idCliente ||
                conversaAtivaId.split('@')[0] === idCliente.split('@')[0]
            );

            if (ehConversaAtiva) {
                if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                    if (!conversaAtivaDados.historicoMensagens.some(m => m.id === mensagem.id)) {
                        conversaAtivaDados.historicoMensagens.push(mensagem);
                    }
                }

                const stream = document.getElementById('chatMensagensStream');

                const msgId = mensagem.id ? `msg-${mensagem.id}` : null;
                if (!msgId || !document.getElementById(msgId)) {
                    const hora = formatarData(mensagem.timestamp);
                    const div = document.createElement('div');
                    if (msgId) div.id = msgId;
                    if (mensagem.id) div.setAttribute('data-msg-id', mensagem.id);
                    if (mensagem.whatsappMessageId) div.setAttribute('data-whatsapp-id', mensagem.whatsappMessageId);
                    div.className = isAtendente ? 'flex flex-col items-end animate-fadeIn w-full' : 'flex flex-col items-start animate-fadeIn w-full';

                    div.innerHTML = renderizarBolhaMensagem(mensagem, isAtendente, nomeContato, hora);

                    if (stream.children.length === 1 && stream.children[0].textContent.includes('Nenhuma mensagem')) {
                        stream.innerHTML = '';
                    }

                    stream.appendChild(div);
                    stream.scrollTop = stream.scrollHeight;
                }
            }

            if (!isAtendente) {
                tocarSomNotificacao();

                if (document.hidden || !ehConversaAtiva) {
                    dispararNotificacaoNavegador(nomeContato || 'Mensagem do Cliente', mensagem.texto, idCliente);
                }

                if (!ehConversaAtiva) {
                    mostrarToast(`${nomeContato || 'Cliente'}: ${mensagem.texto.substring(0, 40)}...`, 'info');
                }
            }

            carregarListaConversas();
        });

        socket.on('status_instancia', (data) => {
            if (data?.status) {
                const badge = document.getElementById('badgeStatus');
                const alerta = document.getElementById('alertaConexao');
                if (data.status === 'open') {
                    badge.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-[#25D366] text-white shadow-xs hover:bg-[#20bd5a] transition cursor-pointer flex-shrink-0';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-white flex-shrink-0"></span><span>WhatsApp Conectado</span>';
                    if (alerta) alerta.classList.add('hidden');
                } else if (data.status === 'qrcode' || data.status === 'close') {
                    badge.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-rose-600 text-white shadow-xs hover:bg-rose-700 transition cursor-pointer flex-shrink-0';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-white flex-shrink-0"></span><span>WhatsApp Desconectado</span>';
                    if (alerta) alerta.classList.remove('hidden');
                }
            }
        });

        socket.on('modo_alterado', (data) => {
            if (conversaAtivaId === data.idCliente) {
                atualizarBadgeModo(data.modo);
            }
        });

        socket.on('mensagem_apagada', (data) => {
            if (!data || !data.idMensagem) return;
            const ehConversaAtiva = conversaAtivaId && data.idCliente && (
                conversaAtivaId === data.idCliente ||
                conversaAtivaId.split('@')[0] === data.idCliente.split('@')[0] ||
                (data.numeroLimpo && conversaAtivaId.split('@')[0] === data.numeroLimpo)
            );

            if (ehConversaAtiva && conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                const msg = conversaAtivaDados.historicoMensagens.find(m => 
                    m.id === data.idMensagem || 
                    m.whatsappMessageId === data.idMensagem ||
                    (data.whatsappMessageId && (m.id === data.whatsappMessageId || m.whatsappMessageId === data.whatsappMessageId))
                );
                if (msg) {
                    msg.apagada = true;
                    msg.apagadaPor = data.apagadaPor || 'cliente';
                    msg.apagadaEm = data.apagadaEm || new Date().toISOString();
                }
                atualizarBolhaMensagemApagada(data.idMensagem, data.apagadaPor);
            }
            carregarListaConversas();
        });

        // ==========================================
        // 3. RENDERIZAÇÃO DE BOLHAS DE MENSAGENS (TEXTO, ÁUDIO, MÍDIAS)
        // ==========================================
        function escapeHtml(texto) {
            if (texto === undefined || texto === null) return '';
            return String(texto)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatarTextoMarkdown(texto) {
            if (!texto) return '';
            const esc = texto.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            return esc.replace(/\*(.*?)\*/g, '<strong class="font-bold">$1</strong>');
        }

        function renderizarBolhaMensagem(msg, isAtendente, nomeContato, hora) {
            const isApagada = msg.apagada === true;
            const tipo = msg.tipo || 'texto';
            const autor = isAtendente ? (msg.atendenteNome ? `Atendente (${msg.atendenteNome})` : 'Atendente') : (nomeContato || 'Cliente');
            const bgClass = isAtendente ? 'bg-[#d9fdd3] text-slate-900 rounded-sm rounded-tr-xs border border-[#c1f5b8] shadow-xs' : 'bg-white text-slate-900 rounded-sm rounded-tl-xs border border-slate-200/80 shadow-xs';
            const autorColor = isAtendente ? 'text-emerald-800 font-bold' : 'text-slate-600 font-bold';
            const horaColor = isAtendente ? 'text-slate-500' : 'text-slate-400';

            let conteudoCorpo = '';

            function resolverSrcMidia(mediaBase64, mediaUrl, mimePadrao) {
                let src = mediaBase64;
                if (!src && mediaUrl && !mediaUrl.includes('whatsapp.net')) {
                    src = mediaUrl;
                }
                if (src && !src.startsWith('data:') && !src.startsWith('http://') && !src.startsWith('https://')) {
                    src = `data:${mimePadrao};base64,${src}`;
                }
                return src || null;
            }

            if (tipo === 'audio' || msg.mediaUrl?.endsWith('.mp3') || msg.mediaUrl?.endsWith('.ogg')) {
                const srcAudio = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'audio/ogg');
                conteudoCorpo = `
                    <div class="space-y-1.5 min-w-[210px] sm:min-w-[240px]">
                        <div class="flex items-center gap-2 text-[11px] font-semibold text-slate-700">
                            <span class="font-mono text-[10px] uppercase font-semibold text-stone-600">Áudio de Voz</span>
                        </div>
                        ${srcAudio ? `<audio controls class="w-full h-8 rounded-lg outline-none" src="${srcAudio}"></audio>` : `<p class="text-xs text-stone-400 font-mono italic">[Áudio recebido]</p>`}
                        ${msg.texto && !msg.texto.includes('[🎙️ Mensagem de Voz]') && !msg.texto.includes('[Áudio de Voz]') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed mt-1 text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'figurinha' || msg.texto === '[🎨 Figurinha]' || msg.texto === '[Figurinha]') {
                const srcSticker = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'image/webp');
                conteudoCorpo = `
                    <div class="space-y-1">
                        ${srcSticker ? `<img src="${srcSticker}" onclick="abrirModalZoom(this.src)" class="max-w-[120px] max-h-32 object-contain cursor-pointer hover:opacity-90 transition">` : `<p class="text-xs font-mono font-medium text-stone-700">[Figurinha]</p>`}
                    </div>
                `;
            } else if (tipo === 'video' || msg.mediaUrl?.match(/\.(mp4|webm|mkv|avi|mov)/i)) {
                const srcVideo = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'video/mp4');
                conteudoCorpo = `
                    <div class="space-y-1.5 max-w-xs">
                        ${srcVideo ? `<video controls class="rounded-sm w-full max-h-60 object-cover border border-slate-200 shadow-xs" src="${srcVideo}"></video>` : `<p class="text-xs text-stone-400 font-mono italic">[Vídeo recebido]</p>`}
                        ${msg.texto && !msg.texto.includes('[Vídeo]') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'imagem' || msg.mediaUrl?.match(/\.(jpeg|jpg|gif|png|webp)/i)) {
                const srcImg = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'image/jpeg');
                conteudoCorpo = `
                    <div class="space-y-1.5">
                        ${srcImg ? `<img src="${srcImg}" onclick="abrirModalZoom(this.src)" 
                             class="rounded-sm max-w-xs max-h-60 object-cover cursor-pointer hover:opacity-90 transition border border-slate-200 shadow-xs">` : `<p class="text-xs text-stone-400 font-mono italic">[Imagem recebida]</p>`}
                        ${msg.texto && !msg.texto.includes('[Imagem]') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else if (tipo === 'documento') {
                const srcDoc = resolverSrcMidia(msg.mediaBase64, msg.mediaUrl, msg.mimetype || 'application/pdf');
                conteudoCorpo = `
                    <div class="space-y-1.5 min-w-[200px]">
                        <div class="flex items-center gap-2.5 p-2 bg-slate-50 rounded-sm border border-slate-200">
                            <div class="w-8 h-8 rounded-sm bg-white border border-stone-200 flex items-center justify-center text-[10px] font-mono font-bold text-stone-700 flex-shrink-0">DOC</div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-bold text-slate-800 truncate">${msg.fileName || 'documento.pdf'}</p>
                                <span class="text-[10px] text-slate-500">Documento / Anexo</span>
                            </div>
                            ${srcDoc ? `<a href="${srcDoc}" download="${msg.fileName || 'documento'}" class="px-2 py-1 bg-stone-900 text-stone-100 hover:bg-stone-800 rounded-sm text-[11px] font-mono font-semibold transition" title="Baixar">Baixar</a>` : '<span class="text-[10px] text-slate-400 italic">Anexo</span>'}
                        </div>
                        ${msg.texto && !msg.texto.startsWith('[📄') && !msg.texto.startsWith('[Documento') ? `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>` : ''}
                    </div>
                `;
            } else {
                conteudoCorpo = `<p class="text-xs whitespace-pre-wrap leading-relaxed text-slate-800">${formatarTextoMarkdown(msg.texto)}</p>`;
            }

            if (isApagada) {
                const quemApagou = msg.apagadaPor === 'atendente' ? 'pelo atendente' : 'pelo cliente';
                conteudoCorpo = `
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-1.5 text-xs italic ${isAtendente ? 'text-emerald-700' : 'text-slate-500'} py-0.5 select-none">
                            <svg class="w-3.5 h-3.5 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                            </svg>
                            <span class="font-medium tracking-wide">Mensagem apagada</span>
                            <span class="text-[10px] opacity-60 font-normal">(${quemApagou})</span>
                        </div>
                        <div class="opacity-70 text-[11px] line-through border-t ${isAtendente ? 'border-emerald-300' : 'border-slate-200'} pt-1.5 max-w-xs break-words select-none text-slate-500">
                            ${conteudoCorpo}
                        </div>
                    </div>
                `;
            }

            let quotedHtml = '';
            if (msg.quoted && (msg.quoted.texto || msg.quoted.id)) {
                const autorCitado = msg.quoted.autor || (msg.quoted.remetente === 'atendente' ? 'Atendente' : (nomeContato || 'Cliente'));
                const textoCitado = formatarTextoMarkdown(msg.quoted.texto || '[Mensagem]');
                const borderCitado = isAtendente ? 'border-emerald-500 bg-emerald-50/80 text-slate-800' : 'border-emerald-500 bg-slate-50 text-slate-800';
                const autorCitadoCor = isAtendente ? 'text-emerald-700' : 'text-emerald-600';
                const targetId = (msg.quoted.id || msg.quoted.whatsappMessageId || '').replace(/'/g, "\\'");

                quotedHtml = `
                    <div onclick="rolarParaMensagem('${targetId}')" 
                         title="Clique para ir até a mensagem original"
                         class="mb-2 p-2 rounded-lg ${borderCitado} border-l-4 cursor-pointer hover:opacity-90 transition select-none group/quote shadow-xs">
                        <div class="flex items-center gap-1.5 text-[10px] font-bold ${autorCitadoCor} mb-0.5">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                            </svg>
                            <span class="truncate">${autorCitado}</span>
                        </div>
                        <p class="text-[11px] opacity-90 line-clamp-2 leading-snug break-words">${textoCitado}</p>
                    </div>
                `;
            }

            const safeMsgId = (msg.id || '').replace(/'/g, "\\'");
            const safeWhatsappId = (msg.whatsappMessageId || msg.id || '').replace(/'/g, "\\'");

            return `
                <div class="relative group max-w-[85%] sm:max-w-[75%] flex items-center gap-1.5 ${isAtendente ? 'flex-row-reverse' : 'flex-row'}">
                    <div class="${bgClass} px-3.5 py-2 shadow-xs w-full cursor-pointer select-text" 
                         onclick="aoClicarBalaoMensagem(event, '${safeMsgId}')"
                         ondblclick="iniciarResposta('${safeMsgId}')">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <span class="text-[10px] font-bold ${autorColor}">${autor}</span>
                            <button type="button" onclick="event.stopPropagation(); iniciarResposta('${safeMsgId}')" 
                                class="text-stone-400 hover:text-stone-700 active:text-amber-600 p-0.5 rounded transition flex items-center gap-0.5"
                                title="Responder a esta mensagem">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                                </svg>
                            </button>
                        </div>
                        ${quotedHtml}
                        ${conteudoCorpo}
                        <span class="text-[9px] ${horaColor} font-medium block text-right mt-1">${hora}</span>
                    </div>
                    <div class="opacity-80 sm:opacity-0 sm:group-hover:opacity-100 sm:focus-within:opacity-100 flex items-center gap-1 transition flex-shrink-0">
                        <button type="button" onclick="iniciarResposta('${safeMsgId}')" title="Responder a esta mensagem (ou duplo-clique no balão)"
                            class="p-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-500 hover:text-slate-800 border border-slate-200 shadow-xs transition cursor-pointer text-xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                            </svg>
                        </button>
                        ${!isApagada ? `
                        <button type="button" onclick="confirmarApagarMensagem('${safeMsgId}', '${safeWhatsappId}')" title="Apagar mensagem para todos"
                            class="p-1.5 rounded-full bg-white hover:bg-rose-50 text-slate-500 hover:text-rose-600 border border-slate-200 hover:border-rose-200 shadow-xs transition cursor-pointer text-xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </button>
                        ` : ''}
                    </div>
                </div>
            `;
        }

        // ==========================================
        // 3.1. GERENCIADOR DE RESPOSTA A MENSAGEM (REPLY)
        // ==========================================
        function aoClicarBalaoMensagem(event, id) {
            // Se o atendente clicou num link, áudio ou botão dentro do balão, não intercepta
            if (event.target.closest('a, button, audio, img, input')) return;
            
            // No celular, tocar no balão seleciona automaticamente para responder
            if (window.innerWidth < 768) {
                iniciarResposta(id);
            }
        }

        function iniciarResposta(id) {
            if (!id || !conversaAtivaDados || !Array.isArray(conversaAtivaDados.historicoMensagens)) return;

            const msg = conversaAtivaDados.historicoMensagens.find(m => m.id === id || m.whatsappMessageId === id);
            if (!msg) return;

            const isAtendente = msg.remetente === 'atendente';
            const autor = isAtendente 
                ? (msg.atendenteNome ? `Você (${msg.atendenteNome})` : 'Você') 
                : (conversaAtivaDados.nome_contato || 'Cliente');

            let preview = msg.texto || '';
            if (msg.tipo && msg.tipo !== 'texto') {
                const icones = {
                    audio: 'Áudio de Voz',
                    imagem: 'Imagem',
                    video: 'Vídeo',
                    documento: msg.fileName || 'Documento',
                    figurinha: 'Figurinha'
                };
                preview = msg.texto && !msg.texto.startsWith('[') ? `${icones[msg.tipo] || msg.tipo}: ${msg.texto}` : (icones[msg.tipo] || msg.tipo);
            }

            mensagemRespondendo = {
                id: msg.id,
                whatsappMessageId: msg.whatsappMessageId || msg.id,
                remoteJid: conversaAtivaId,
                fromMe: isAtendente,
                autor: autor,
                remetente: msg.remetente,
                texto: preview.replace(/\r?\n/g, ' ').substring(0, 100),
                tipo: msg.tipo || 'texto'
            };

            const barra = document.getElementById('barraRespostaMensagem');
            const autorEl = document.getElementById('autorRespostaTexto');
            const previewEl = document.getElementById('previewRespostaTexto');

            if (barra && autorEl && previewEl) {
                autorEl.textContent = autor;
                previewEl.textContent = preview;
                barra.classList.remove('hidden');
            }

            const input = document.getElementById('inputMensagemChat');
            if (input) {
                input.focus({ preventScroll: true });
            }
        }

        function cancelarResposta() {
            mensagemRespondendo = null;
            const barra = document.getElementById('barraRespostaMensagem');
            if (barra) {
                barra.classList.add('hidden');
            }
        }

        function rolarParaMensagem(targetId) {
            if (!targetId) return;
            const stream = document.getElementById('chatMensagensStream');
            if (!stream) return;

            let el = document.getElementById(`msg-${targetId}`);
            if (!el) {
                el = stream.querySelector(`[data-msg-id="${targetId}"]`) || stream.querySelector(`[data-whatsapp-id="${targetId}"]`);
            }

            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ring-2', 'ring-emerald-400', 'bg-emerald-500/10', 'rounded-sm', 'transition-all', 'duration-500');
                setTimeout(() => {
                    el.classList.remove('ring-2', 'ring-emerald-400', 'bg-emerald-500/10');
                }, 1800);
            } else {
                mostrarToast('A mensagem citada é anterior ou não foi carregada no histórico visível.', 'info');
            }
        }

        // ==========================================
        // 3.2. GERENCIADOR DE EXCLUSÃO DE MENSAGEM (APAGAR PARA TODOS)
        // ==========================================
        function confirmarApagarMensagem(idMensagem, whatsappMessageId) {
            if (!conversaAtivaId || !idMensagem) return;
            mensagemParaApagar = {
                id_cliente: conversaAtivaId,
                id_mensagem: idMensagem,
                whatsappMessageId: whatsappMessageId || idMensagem
            };

            const modal = document.getElementById('modalConfirmarApagar');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }

        function fecharModalConfirmarApagar() {
            const modal = document.getElementById('modalConfirmarApagar');
            if (modal) {
                modal.classList.add('hidden');
            }
            mensagemParaApagar = null;
            const btn = document.getElementById('btnConfirmarApagar');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Apagar para Todos</span>';
            }
        }

        async function executarApagarMensagemConfirmada() {
            if (!mensagemParaApagar || !mensagemParaApagar.id_cliente || !mensagemParaApagar.id_mensagem) {
                fecharModalConfirmarApagar();
                return;
            }

            const btn = document.getElementById('btnConfirmarApagar');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>⏳</span><span>Apagando...</span>';
            }

            const payload = { ...mensagemParaApagar };

            try {
                const res = await fetch('/admin/apagar-mensagem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    mostrarToast('Mensagem apagada com sucesso!', 'sucesso');
                    fecharModalConfirmarApagar();

                    // Atualiza no cache de mensagens da conversa ativa
                    if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                        const msg = conversaAtivaDados.historicoMensagens.find(m => 
                            m.id === payload.id_mensagem || 
                            m.whatsappMessageId === payload.whatsappMessageId
                        );
                        if (msg) {
                            msg.apagada = true;
                            msg.apagadaPor = 'atendente';
                            msg.apagadaEm = new Date().toISOString();
                        }
                    }

                    // Atualiza a bolha na tela
                    atualizarBolhaMensagemApagada(payload.id_mensagem, 'atendente');
                    carregarListaConversas();
                } else {
                    mostrarToast(data.message || 'Não foi possível apagar a mensagem.', 'erro');
                }
            } catch (err) {
                console.error('Erro ao apagar mensagem:', err);
                mostrarToast('Falha na comunicação ao tentar apagar mensagem.', 'erro');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Apagar para Todos</span>';
                }
            }
        }

        function atualizarBolhaMensagemApagada(idMensagem, apagadaPor) {
            if (!idMensagem) return;
            const stream = document.getElementById('chatMensagensStream');
            if (!stream) return;

            let el = document.getElementById(`msg-${idMensagem}`);
            if (!el) {
                el = stream.querySelector(`[data-msg-id="${idMensagem}"]`) || stream.querySelector(`[data-whatsapp-id="${idMensagem}"]`);
            }

            if (!el) return;

            if (conversaAtivaDados && Array.isArray(conversaAtivaDados.historicoMensagens)) {
                const msg = conversaAtivaDados.historicoMensagens.find(m => 
                    m.id === idMensagem || 
                    m.whatsappMessageId === idMensagem ||
                    (m.id && idMensagem && (m.id.includes(idMensagem) || idMensagem.includes(m.id)))
                );
                if (msg) {
                    msg.apagada = true;
                    msg.apagadaPor = apagadaPor || msg.apagadaPor || 'cliente';
                    const isAtendente = msg.remetente === 'atendente';
                    const hora = formatarData(msg.timestamp);
                    el.innerHTML = renderizarBolhaMensagem(msg, isAtendente, conversaAtivaDados.nome_contato, hora);
                }
            }
        }

        // ==========================================
        // 4. GRAVADOR DE ÁUDIO NO NAVEGADOR (MediaRecorder)
        // ==========================================
        async function iniciarGravacaoAudio() {
            if (!conversaAtivaId) return;

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) audioChunks.push(e.data);
                };

                mediaRecorder.start();
                segundosGravacao = 0;

                // UI
                document.getElementById('formChatNormal').classList.add('hidden');
                document.getElementById('painelGravacaoAudio').classList.remove('hidden');
                document.getElementById('tempoGravacao').textContent = '00:00';

                timerGravacaoInterval = setInterval(() => {
                    segundosGravacao++;
                    const min = String(Math.floor(segundosGravacao / 60)).padStart(2, '0');
                    const sec = String(segundosGravacao % 60).padStart(2, '0');
                    document.getElementById('tempoGravacao').textContent = `${min}:${sec}`;
                }, 1000);

            } catch (err) {
                console.error('Erro ao acessar microfone:', err);
                mostrarToast('Não foi possível acessar o microfone. Verifique as permissões.', 'erro');
            }
        }

        function cancelarGravacaoAudio() {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
            }
            clearInterval(timerGravacaoInterval);
            audioChunks = [];

            document.getElementById('painelGravacaoAudio').classList.add('hidden');
            document.getElementById('formChatNormal').classList.remove('hidden');
        }

        async function finalizarEEnviarAudio() {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') return;

            mediaRecorder.onstop = async () => {
                const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                mediaRecorder.stream.getTracks().forEach(track => track.stop());

                const reader = new FileReader();
                reader.readAsDataURL(audioBlob);
                reader.onloadend = async () => {
                    const base64Audio = reader.result;

                    try {
                        mostrarToast('Enviando áudio...', 'info');
                        const payloadAudio = {
                            id_cliente: conversaAtivaId,
                            audioBase64: base64Audio
                        };
                        if (mensagemRespondendo) {
                            payloadAudio.quoted = { ...mensagemRespondendo };
                            cancelarResposta();
                        }

                        const res = await fetch('/admin/enviar-audio', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payloadAudio)
                        });

                        const result = await res.json();
                        if (result.success) {
                            mostrarToast('Áudio enviado com sucesso!', 'sucesso');
                        } else {
                            mostrarToast(result.message || 'Erro ao enviar áudio', 'erro');
                        }
                    } catch (err) {
                        mostrarToast('Falha na comunicação ao enviar áudio.', 'erro');
                    }
                };
            };

            mediaRecorder.stop();
            clearInterval(timerGravacaoInterval);
            document.getElementById('painelGravacaoAudio').classList.add('hidden');
            document.getElementById('formChatNormal').classList.remove('hidden');
        }

        // ==========================================
        // 5. ENVIO DE ANEXOS, CLIPBOARD (PASTE) & MODAIS
        // ==========================================
        function processarArquivoAnexo(file) {
            if (!file) return;
            if (!conversaAtivaId) {
                mostrarToast('Selecione uma conversa ativa para enviar imagens ou anexos.', 'info');
                return;
            }

            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onloadend = () => {
                const base64 = reader.result;
                const isImage = file.type.startsWith('image/');
                const isVideo = file.type.startsWith('video/');

                let mediatype = 'document';
                if (isImage) mediatype = 'image';
                else if (isVideo) mediatype = 'video';

                const fileName = (file.name && file.name !== 'image.png') ? file.name : `imagem_colada_${Date.now()}.png`;

                anexoSelecionado = {
                    file: file,
                    base64: base64,
                    mediatype: mediatype,
                    mimetype: file.type || (isImage ? 'image/png' : isVideo ? 'video/mp4' : 'application/pdf'),
                    fileName: fileName
                };

                const container = document.getElementById('previewAnexoContainer');
                if (isImage) {
                    container.innerHTML = `
                        <img src="${base64}" class="max-h-44 rounded-sm object-contain shadow-sm mb-2 border border-slate-200">
                        <span class="text-xs text-slate-500 font-semibold">${fileName} (${(file.size / 1024).toFixed(1)} KB)</span>
                    `;
                } else if (isVideo) {
                    container.innerHTML = `
                        <video src="${base64}" controls class="max-h-44 rounded-sm object-contain shadow-sm mb-2 border border-slate-200"></video>
                        <span class="text-xs text-slate-500 font-semibold">${fileName} (${(file.size / 1024).toFixed(1)} KB)</span>
                    `;
                } else {
                    container.innerHTML = `
                        <div class="text-xs font-mono font-bold text-stone-500 mb-2 uppercase">Arquivo Selecionado</div>
                        <span class="text-xs text-slate-800 font-bold truncate max-w-xs">${fileName}</span>
                        <span class="text-[11px] text-slate-500 mt-1">${(file.size / 1024).toFixed(1)} KB</span>
                    `;
                }

                document.getElementById('inputLegendaAnexo').value = '';
                document.getElementById('modalAnexo').classList.remove('hidden');
                setTimeout(() => document.getElementById('inputLegendaAnexo').focus(), 50);
            };
        }

        function aoSelecionarArquivo(event) {
            const file = event.target.files[0];
            if (file) processarArquivoAnexo(file);
            event.target.value = '';
        }

        // Suporte para Colar Imagens/Arquivos da Área de Transferência (Ctrl + V)
        document.addEventListener('paste', (event) => {
            const items = (event.clipboardData || window.clipboardData)?.items;
            if (!items) return;

            for (const item of items) {
                if (item.type.indexOf('image') !== -1 || item.type.indexOf('video') !== -1 || item.kind === 'file') {
                    const file = item.getAsFile();
                    if (file) {
                        event.preventDefault();
                        processarArquivoAnexo(file);
                        break;
                    }
                }
            }
        });

        // Suporte para Drag and Drop de Imagens/Arquivos no Painel de Chat
        const chatPanelEl = document.getElementById('painelChat');
        if (chatPanelEl) {
            chatPanelEl.addEventListener('dragover', (e) => e.preventDefault());
            chatPanelEl.addEventListener('drop', (e) => {
                e.preventDefault();
                if (e.dataTransfer?.files?.length > 0) {
                    processarArquivoAnexo(e.dataTransfer.files[0]);
                }
            });
        }

        function fecharModalAnexo() {
            document.getElementById('modalAnexo').classList.add('hidden');
            anexoSelecionado = null;
        }

        async function enviarAnexoConfirmado() {
            if (!anexoSelecionado || !conversaAtivaId) return;

            const legenda = document.getElementById('inputLegendaAnexo').value.trim();
            const payload = {
                id_cliente: conversaAtivaId,
                mediaBase64: anexoSelecionado.base64,
                mediatype: anexoSelecionado.mediatype,
                mimetype: anexoSelecionado.mimetype,
                fileName: anexoSelecionado.fileName,
                caption: legenda
            };

            if (mensagemRespondendo) {
                payload.quoted = { ...mensagemRespondendo };
                cancelarResposta();
            }

            fecharModalAnexo();
            mostrarToast('Enviando anexo...', 'info');

            try {
                const res = await fetch('/admin/enviar-midia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const errText = await res.text();
                    console.error('Erro HTTP ao enviar mídia:', res.status, errText);
                    mostrarToast(`Erro (${res.status}): Não foi possível processar o envio da mídia.`, 'erro');
                    return;
                }

                const result = await res.json();
                if (result.success) {
                    mostrarToast('Anexo enviado com sucesso!', 'sucesso');
                } else {
                    mostrarToast(result.message || 'Erro ao enviar anexo', 'erro');
                }
            } catch (err) {
                console.error('Erro ao enviar anexo:', err);
                mostrarToast('Falha na comunicação ao enviar anexo.', 'erro');
            }
        }

