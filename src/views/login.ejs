<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-100">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Favo de Mel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>

<body class="h-full bg-slate-100 text-slate-800 flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Background Decorator Spheres -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-amber-300/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-300/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
        <!-- Logo & Branding Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-400 to-amber-500 shadow-lg shadow-amber-500/20 mb-4 border border-amber-300">
                <span class="text-3xl">🍯</span>
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Favo de Mel</h1>
            <p class="text-xs text-slate-500 mt-1 font-medium">Painel de Atendimento e Vendas WhatsApp</p>
        </div>

        <!-- Login Card -->
        <div class="bg-white/95 backdrop-blur-xl border border-slate-200/90 p-8 rounded-3xl shadow-xl shadow-slate-200/50">
            <h2 class="text-lg font-bold text-slate-800 mb-6 text-center">Acesse a sua conta</h2>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 p-3.5 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-xs text-rose-600 font-semibold animate-shake">
                    <span class="text-base">⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <div>
                    <label for="email" class="block text-xs font-bold text-slate-700 mb-2">Usuário ou E-mail</label>
                    <div class="relative">
                        <input type="text" id="email" name="email" required placeholder="admin ou admin@favodemel.com"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-xs font-bold text-slate-700 mb-2">Senha</label>
                    <div class="relative">
                        <input type="password" id="password" name="password" required placeholder="••••••••"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition">
                    </div>
                </div>

                <button type="submit"
                    class="w-full py-3.5 px-4 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold rounded-xl text-sm shadow-md shadow-amber-500/25 active:scale-[0.98] transition duration-200 flex items-center justify-center gap-2 cursor-pointer">
                    <span>Entrar no Painel</span>
                    <span class="text-lg">➔</span>
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                <p class="text-[11px] text-slate-400 font-medium">Favo de Mel &copy; 2026 - Gestão de Pedidos e Atendimento</p>
            </div>
        </div>
    </div>
</body>

</html>
